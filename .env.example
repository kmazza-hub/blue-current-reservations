# Blue Current runtime mode
BLUE_CURRENT_ENV=development
PORT=8787

# Persistence
# Production: use an absolute path outside OneDrive/Dropbox/Google Drive.
# BLUE_CURRENT_DB=C:\BlueCurrent\data\blue-current.json

# Browser origin allowlist (required when BLUE_CURRENT_ENV=production)
# Production example:
# BLUE_CURRENT_ALLOWED_ORIGINS=https://bluecurrentco.com,https://app.bluecurrentco.com
BLUE_CURRENT_ALLOWED_ORIGINS=

# Request boundary
BLUE_CURRENT_MAX_BODY_BYTES=1000000
BLUE_CURRENT_RATE_WINDOW_MS=60000
BLUE_CURRENT_RATE_LIMIT=600
BLUE_CURRENT_AUTH_RATE_LIMIT=20
BLUE_CURRENT_WEBHOOK_RATE_LIMIT=180

# Authentication/session policy
BLUE_CURRENT_SESSION_HOURS=12
BLUE_CURRENT_SESSION_IDLE_MINUTES=120
BLUE_CURRENT_SESSION_TOUCH_MINUTES=5
BLUE_CURRENT_MAX_ACTIVE_SESSIONS=10
BLUE_CURRENT_FAILED_LOGIN_WINDOW_MINUTES=15
BLUE_CURRENT_FAILED_LOGIN_THRESHOLD=5
BLUE_CURRENT_LOGIN_LOCK_MINUTES=15
BLUE_CURRENT_REVOKED_SESSION_RETENTION_HOURS=168

# Connector secrets
# Store secret VALUES in environment variables only. Connector auth bindings
# persist only the environment variable name, e.g.:
# TOAST_WEBHOOK_SECRET=replace-at-deploy-time
# OPENTABLE_API_TOKEN=replace-at-deploy-time
