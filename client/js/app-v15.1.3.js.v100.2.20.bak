$("#addWalkIn")?.addEventListener("click", () => {
  const list = $("#waitlistQueue");
  const item = document.createElement("article");
  item.className = "queue-item";
  item.innerHTML = `
    <span class="queue-time">0m</span>
    <div><strong>New walk-in</strong><small>Party of 2 · Flexible</small></div>
    <button type="button">Seat</button>
  `;
  list.appendChild(item);

  const current = Number($("#waitlistBadge").textContent);
  $("#waitlistBadge").textContent = current + 1;
  $("#hostWaiting").textContent = current + 1;
});

// V100.2.13 — Reservation Arrival & One-Tap Seating Flow
(() => {
  const guestName = "Anthony Russo";
  const shortName = "Anthony";
  const button = $("#assignTableButton");
  const detail = document.getElementById("hostTableDetail");
  if (!button || !detail) return;

  const tables = () => [...document.querySelectorAll(".host-table")];
  const getTableState = (table) =>
    ["available", "reserved", "seated", "cleaning"].find((name) => table?.classList.contains(name)) || "selected";
  const titleCase = (value) => value ? value.charAt(0).toUpperCase() + value.slice(1) : "Selected";
  const tableNumberOf = (table) => table?.dataset?.table || "";

  const getArrival = () => [...document.querySelectorAll("#arrivalQueue .queue-item.arrival")]
    .find((item) => item.querySelector("strong")?.textContent?.trim() === guestName) || null;

  const arrivalStatus = () => {
    const arrival = getArrival();
    if (!arrival) return "expected";
    if (arrival.dataset.bcGuestStatus) return arrival.dataset.bcGuestStatus;
    const text = arrival.querySelector(".arrival-chip")?.textContent?.trim().toLowerCase() || "";
    if (text.includes("seated")) return "seated";
    if (text.includes("arrived")) return "arrived";
    return "expected";
  };

  const setNumber = (selector, updater) => {
    const node = $(selector);
    if (!node) return;
    const current = Number(node.textContent || 0);
    node.textContent = String(Math.max(0, updater(current)));
  };

  const setDetailVisibility = (visible) => {
    detail.hidden = !visible;
    if (visible) {
      detail.removeAttribute("aria-hidden");
      detail.classList.add("bc-detail-open");
    } else {
      detail.setAttribute("aria-hidden", "true");
      detail.classList.remove("bc-detail-open");
    }
  };

  const setLifecycleStatus = (message) => {
    let status = document.getElementById("hostTableLifecycleStatus");
    if (!status) {
      status = document.createElement("div");
      status.id = "hostTableLifecycleStatus";
      status.className = "host-table-lifecycle-status";
      status.setAttribute("role", "status");
      button.parentNode?.insertBefore(status, button);
    }
    status.textContent = message || "";
    status.hidden = !message;
  };

  const setSelectedHeading = (table) => {
    const number = tableNumberOf(table);
    const heading = detail.querySelector(".host-table-detail-head strong") || detail.querySelector("strong");
    if (heading) heading.textContent = `Table ${number}`;
    const chip = detail.querySelector(".cleaning-chip");
    if (chip) chip.textContent = titleCase(getTableState(table));
  };

  const setGuestGrid = (table) => {
    const grid = detail.querySelector(".host-table-detail-grid");
    if (!grid) return;
    const last = grid.querySelector("div:last-child");
    const label = last?.querySelector("span");
    const value = last?.querySelector("strong");
    const number = tableNumberOf(table);
    const seatedHere = table.dataset.bcGuestStatus === "seated" && table.dataset.bcGuestName === guestName;
    if (label) label.textContent = seatedHere ? "Current guest" : "Next guest";
    if (value) value.textContent = seatedHere ? `${guestName} · Table ${number}` : guestName;
  };

  const assignment = window.__bcHostAssignmentV100_2_13 || {
    status: "none",
    table: null,
    tableNumber: null,
    guestName
  };
  window.__bcHostAssignmentV100_2_13 = assignment;

  const isAssignable = (table) => {
    const state = getTableState(table);
    return state === "available" || state === "cleaning";
  };

  const ensureArrivalAction = () => {
    const arrival = getArrival();
    if (!arrival) return null;
    const chip = arrival.querySelector(".arrival-chip");
    if (!chip) return null;

    let action = arrival.querySelector(".bc-arrival-action-v100-2-13");
    if (!action) {
      action = document.createElement("button");
      action.type = "button";
      action.className = "bc-arrival-action-v100-2-13";
      action.textContent = "Mark arrived";
      action.setAttribute("aria-label", `Mark ${guestName} arrived`);
      chip.insertAdjacentElement("afterend", action);
    }

    const status = arrivalStatus();
    action.hidden = status !== "expected";
    return action;
  };

  const updateArrivalState = (status, tableNumber = null) => {
    const arrival = getArrival();
    if (!arrival) return;
    const chip = arrival.querySelector(".arrival-chip");
    arrival.dataset.bcGuestStatus = status;

    if (status === "arrived") {
      arrival.removeAttribute("data-bc-table");
      arrival.setAttribute("aria-label", `${guestName}, arrived`);
      if (chip) {
        chip.classList.remove("pending", "bc-seated-table");
        chip.textContent = "Arrived";
      }
    }

    if (status === "seated") {
      arrival.dataset.bcTable = tableNumber || "";
      arrival.setAttribute("aria-label", `${guestName}, seated at Table ${tableNumber}`);
      if (chip) {
        chip.classList.remove("pending");
        chip.classList.add("bc-seated-table");
        chip.textContent = `Seated · Table ${tableNumber}`;
      }
    }

    const action = ensureArrivalAction();
    if (action) action.hidden = status !== "expected";
  };

  const updateButtonForSelection = (table) => {
    const number = tableNumberOf(table);
    const state = getTableState(table);
    const guestStatus = arrivalStatus();
    button.hidden = false;
    button.disabled = false;
    delete button.dataset.bcTargetTable;

    if (assignment.status === "seated" || guestStatus === "seated") {
      button.hidden = true;
      button.disabled = true;
      setLifecycleStatus(`${guestName} is already seated at Table ${assignment.tableNumber || table.dataset.bcTable || number}.`);
      return;
    }

    if (assignment.status === "assigned" && assignment.table === table) {
      button.dataset.bcTargetTable = number;
      if (guestStatus === "arrived") {
        button.dataset.bcAssignmentState = "assigned";
        button.disabled = false;
        button.textContent = `Seat ${shortName} at Table ${number}`;
        setLifecycleStatus(`${guestName} has arrived. Table ${number} is held and ready to seat.`);
      } else {
        button.dataset.bcAssignmentState = "held";
        button.disabled = true;
        button.textContent = `Table ${number} held for ${shortName}`;
        setLifecycleStatus(`Table ${number} is held for ${guestName}. Mark the reservation arrived before seating.`);
      }
      return;
    }

    if (!isAssignable(table)) {
      button.dataset.bcAssignmentState = "blocked";
      button.disabled = true;
      button.textContent = `Table ${number} unavailable`;
      if (assignment.status === "assigned") {
        setLifecycleStatus(`${guestName} remains assigned to Table ${assignment.tableNumber}. Choose an available or cleaning table to move the assignment.`);
      } else {
        setLifecycleStatus(`Table ${number} is ${state}. Choose an available or cleaning table for ${guestName}.`);
      }
      return;
    }

    button.dataset.bcTargetTable = number;
    if (assignment.status === "assigned") {
      button.dataset.bcAssignmentState = "reassign";
      button.textContent = `Move ${shortName} to Table ${number}`;
      setLifecycleStatus(`${guestName} is currently assigned to Table ${assignment.tableNumber}.`);
      return;
    }

    if (guestStatus === "arrived") {
      button.dataset.bcAssignmentState = "seat-ready";
      button.textContent = `Seat ${shortName} at Table ${number}`;
      setLifecycleStatus(`${guestName} has arrived. Table ${number} is ${state} and ready for one-tap seating.`);
    } else {
      button.dataset.bcAssignmentState = "ready";
      button.textContent = `Reserve Table ${number} for ${shortName}`;
      setLifecycleStatus(`${guestName} is expected. Hold Table ${number} now, then seat after arrival.`);
    }
  };

  const selectTable = (table) => {
    if (!table) return;
    tables().forEach((item) => item.classList.remove("selected"));
    table.classList.add("selected");
    window.__bcHostSelectedTableV100_2_13 = table;
    setSelectedHeading(table);
    setGuestGrid(table);
    setDetailVisibility(true);
    updateButtonForSelection(table);
  };

  const adjustOutOfState = (state) => {
    if (state === "cleaning") setNumber("#cleaningCount", (value) => value - 1);
    if (state === "available") setNumber("#availableCount", (value) => value - 1);
  };

  const adjustBackToState = (state) => {
    if (state === "cleaning") setNumber("#cleaningCount", (value) => value + 1);
    if (state === "available") setNumber("#availableCount", (value) => value + 1);
  };

  const reserveTableForGuest = (table) => {
    const number = tableNumberOf(table);
    const priorState = getTableState(table);
    table.dataset.bcPriorTableState = priorState;
    table.classList.remove("cleaning", "available", "seated");
    table.classList.add("reserved", "selected");
    table.dataset.bcGuestName = guestName;
    table.dataset.bcGuestStatus = "assigned";
    const small = table.querySelector("small");
    if (small) small.textContent = "7:30";
    adjustOutOfState(priorState);
    setNumber("#reservedCount", (value) => value + 1);

    assignment.status = "assigned";
    assignment.table = table;
    assignment.tableNumber = number;
    setSelectedHeading(table);
    setGuestGrid(table);
    $("#hostRecommendation") && ($("#hostRecommendation").textContent = `Table ${number} held for ${guestName} at 7:30 PM`);
    updateButtonForSelection(table);
  };

  const releaseAssignedTable = () => {
    const oldTable = assignment.table;
    if (!oldTable) return;
    const priorState = oldTable.dataset.bcPriorTableState || "available";
    oldTable.classList.remove("reserved", "selected");
    oldTable.classList.add(priorState);
    delete oldTable.dataset.bcGuestName;
    delete oldTable.dataset.bcGuestStatus;
    const small = oldTable.querySelector("small");
    if (small) small.textContent = priorState === "available" ? "Open" : (small.textContent || "12 min");
    adjustBackToState(priorState);
    setNumber("#reservedCount", (value) => value - 1);
  };

  const seatAssignedGuest = () => {
    const table = assignment.table;
    if (!table) return;
    const number = assignment.tableNumber || tableNumberOf(table);

    table.classList.remove("cleaning", "available", "reserved");
    table.classList.add("seated", "selected");
    const small = table.querySelector("small");
    if (small) small.textContent = "Seated";
    table.dataset.bcGuestName = guestName;
    table.dataset.bcGuestStatus = "seated";

    assignment.status = "seated";
    assignment.table = table;
    assignment.tableNumber = number;

    const chip = detail.querySelector(".cleaning-chip");
    if (chip) chip.textContent = "Occupied";
    $("#hostRecommendation") && ($("#hostRecommendation").textContent = `${guestName} seated at Table ${number}`);
    setLifecycleStatus(`${guestName} · Party of 4 · Seated at Table ${number}`);
    updateArrivalState("seated", number);

    setGuestGrid(table);
    setNumber("#reservedCount", (value) => value - 1);
    setNumber("#seatedCount", (value) => value + 1);
    button.dataset.bcAssignmentState = "seated";
    button.hidden = true;
    button.disabled = true;
    setDetailVisibility(false);
  };

  const seatArrivedGuestDirectly = (table) => {
    reserveTableForGuest(table);
    seatAssignedGuest();
  };

  if (!window.__bcDynamicTableSelectionV100_2_13) {
    window.__bcDynamicTableSelectionV100_2_13 = true;
    tables().forEach((table) => table.addEventListener("click", () => selectTable(table)));
  }

  const arrivalAction = ensureArrivalAction();
  if (arrivalAction && !arrivalAction.dataset.bcBoundV100213) {
    arrivalAction.dataset.bcBoundV100213 = "true";
    arrivalAction.addEventListener("click", () => {
      updateArrivalState("arrived");
      const selected = window.__bcHostSelectedTableV100_2_13;
      if (selected) updateButtonForSelection(selected);
    });
  }

  if (!window.__bcDynamicAssignmentClickV100_2_13) {
    window.__bcDynamicAssignmentClickV100_2_13 = true;
    button.addEventListener("click", () => {
      const state = button.dataset.bcAssignmentState || "blocked";
      const selected = window.__bcHostSelectedTableV100_2_13;
      if (!selected || state === "blocked" || state === "held" || button.disabled) return;

      if (state === "ready") {
        if (!isAssignable(selected)) return updateButtonForSelection(selected);
        reserveTableForGuest(selected);
        return;
      }

      if (state === "seat-ready") {
        if (!isAssignable(selected)) return updateButtonForSelection(selected);
        seatArrivedGuestDirectly(selected);
        return;
      }

      if (state === "reassign") {
        if (!isAssignable(selected)) return updateButtonForSelection(selected);
        releaseAssignedTable();
        reserveTableForGuest(selected);
        return;
      }

      if (state === "assigned") {
        if (assignment.table !== selected) return updateButtonForSelection(selected);
        if (arrivalStatus() !== "arrived") return updateButtonForSelection(selected);
        seatAssignedGuest();
      }
    });
  }

  // V100.2.13 keeps arrival state visible throughout the host flow and starts
  // with no transient table-detail card until the host explicitly selects a table.
  tables().forEach((table) => table.classList.remove("selected"));
  window.__bcHostSelectedTableV100_2_13 = null;
  button.dataset.bcAssignmentState = "blocked";
  button.hidden = true;
  button.disabled = true;
  setLifecycleStatus("");
  setDetailVisibility(false);
})();

// V100.2.14 — Host Stand Workspace Simplification
(() => {
  const hostWorkspace = document.querySelector('.host-workspace');
  const floorPanel = document.querySelector('.host-floor-panel');
  const queuePanel = document.querySelector('.host-queue-panel');
  const navButtons = [...document.querySelectorAll('.host-nav button')];
  const hostMain = document.querySelector('.host-main');
  if (!hostWorkspace || !floorPanel || !queuePanel || !navButtons.length || !hostMain) return;

  const normalizeLabel = (button) => (button?.textContent || '').replace(/[^a-zA-Z]/g, '').toLowerCase();
  const navByName = Object.fromEntries(navButtons.map((button) => [normalizeLabel(button), button]));
  const floorNav = navByName.floor;
  const reservationsNav = navByName.reservations;
  const waitlistNav = navByName.waitlist;
  const guestsNav = navByName.guests;
  if (!floorNav || !reservationsNav || !waitlistNav || !guestsNav) return;

  // One job, one screen, one obvious next action.
  // The floor remains powerful underneath, but transient floor UI never leaks into another workspace.
  const styleId = 'bc-host-workspace-simplification-v100-2-14';
  if (!document.getElementById(styleId)) {
    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = `
      .host-workspace.bc-single-workspace { grid-template-columns: minmax(0,1fr) !important; }
      .host-workspace.bc-single-workspace .host-queue-panel { width:100%; max-width:none; min-height:560px; }
      .host-workspace.bc-single-workspace .queue-tabs { max-width:520px; margin-bottom:22px; }
      .host-workspace.bc-single-workspace .queue-list { display:grid; gap:12px; }
      .host-workspace.bc-single-workspace .queue-item { min-height:78px; padding:16px 18px; }
      .bc-host-workspace-panel { grid-column:1 / -1; min-height:560px; border:1px solid rgba(131,197,187,.25); border-radius:24px; background:#0d3441; padding:28px; color:#fff; }
      .bc-host-workspace-head { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:24px; }
      .bc-host-workspace-head small { display:block; color:#83c5bb; text-transform:uppercase; letter-spacing:.12em; font-weight:800; margin-bottom:5px; }
      .bc-host-workspace-head h4 { margin:0; font-size:30px; line-height:1.05; color:#fff; }
      .bc-host-workspace-head p { margin:7px 0 0; color:#b9d5d7; font-size:16px; }
      .bc-guest-search-input { width:100%; min-height:58px; border-radius:14px; border:2px solid #83c5bb; padding:0 16px; background:#082632; color:#fff; font-size:19px; outline:none; }
      .bc-guest-search-input::placeholder { color:#91aeb2; }
      .bc-guest-results { display:grid; gap:10px; margin-top:18px; }
      .bc-guest-result { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center; min-height:76px; padding:14px 16px; border:1px solid rgba(131,197,187,.22); border-radius:16px; background:#123d4b; }
      .bc-guest-result strong { display:block; font-size:19px; color:#fff; }
      .bc-guest-result span { display:block; margin-top:3px; color:#b9d5d7; font-size:15px; }
      .bc-guest-result em { font-style:normal; border-radius:999px; padding:7px 10px; background:#edf5f1; color:#15343c; font-weight:800; font-size:13px; }
      .bc-guest-empty { padding:22px; border-radius:16px; background:#123d4b; color:#b9d5d7; font-size:16px; }
      .bc-workspace-title-strip { margin:0 0 18px; }
      .bc-workspace-title-strip small { display:block; color:#83c5bb; text-transform:uppercase; letter-spacing:.12em; font-weight:800; }
      .bc-workspace-title-strip strong { display:block; color:#fff; font-size:26px; margin-top:4px; }
      .bc-workspace-title-strip span { display:block; color:#b9d5d7; margin-top:5px; }
      .bc-host-focus-hidden { display:none !important; }
    `;
    document.head.appendChild(style);
  }

  let guestPanel = document.getElementById('bcHostGuestsWorkspaceV100_2_14');
  if (!guestPanel) {
    guestPanel = document.createElement('section');
    guestPanel.id = 'bcHostGuestsWorkspaceV100_2_14';
    guestPanel.className = 'bc-host-workspace-panel';
    guestPanel.hidden = true;
    guestPanel.innerHTML = `
      <div class="bc-host-workspace-head">
        <div>
          <small>Guests</small>
          <h4>Find a guest</h4>
          <p>Search tonight's reservations and waitlist. Keep the answer on one screen.</p>
        </div>
      </div>
      <label>
        <span class="sr-only">Guest name</span>
        <input id="bcHostGuestSearchV100_2_14" class="bc-guest-search-input" type="search" autocomplete="off" placeholder="Start typing a guest name">
      </label>
      <div id="bcHostGuestResultsV100_2_14" class="bc-guest-results" aria-live="polite"></div>
    `;
    hostWorkspace.appendChild(guestPanel);
  }

  let titleStrip = document.getElementById('bcHostWorkspaceTitleV100_2_14');
  if (!titleStrip) {
    titleStrip = document.createElement('div');
    titleStrip.id = 'bcHostWorkspaceTitleV100_2_14';
    titleStrip.className = 'bc-workspace-title-strip';
    titleStrip.hidden = true;
    queuePanel.insertBefore(titleStrip, queuePanel.firstChild);
  }

  const heading = hostMain.querySelector('.host-topbar h3');
  const subtitle = hostMain.querySelector('.host-topbar small');
  const originalHeading = heading?.textContent || 'Dining room';
  const originalSubtitle = subtitle?.textContent || '';

  const clearTransientFloorUI = () => {
    document.querySelectorAll('.host-table.selected').forEach((table) => table.classList.remove('selected'));
    const detail = document.getElementById('hostTableDetail');
    if (detail) {
      detail.hidden = true;
      detail.setAttribute('aria-hidden', 'true');
      detail.classList.remove('bc-detail-open');
    }
    window.__bcHostSelectedTableV100_2_13 = null;
    window.__bcHostSelectedTableV100_2_12 = null;
  };

  const setTopbar = (title, helper) => {
    if (heading) heading.textContent = title;
    if (subtitle) subtitle.textContent = helper;
  };

  const forceQueueView = (name) => {
    const waitlist = document.getElementById('waitlistQueue');
    const arrivals = document.getElementById('arrivalQueue');
    const tabs = [...queuePanel.querySelectorAll('.queue-tabs button')];
    tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.queue === name));
    if (waitlist) waitlist.classList.toggle('hidden', name !== 'waitlist');
    if (arrivals) arrivals.classList.toggle('hidden', name === 'waitlist');
  };

  const setTitleStrip = (kicker, title, helper) => {
    titleStrip.innerHTML = `<small>${kicker}</small><strong>${title}</strong><span>${helper}</span>`;
    titleStrip.hidden = false;
  };

  const collectGuests = () => {
    const results = [];
    document.querySelectorAll('#arrivalQueue .queue-item.arrival').forEach((row) => {
      const name = row.querySelector('strong')?.textContent?.trim();
      if (!name) return;
      const detailText = row.querySelector('small')?.textContent?.trim() || 'Reservation';
      const status = row.querySelector('.arrival-chip')?.textContent?.trim() || 'Reservation';
      results.push({ name, detail: detailText, status });
    });
    document.querySelectorAll('#waitlistQueue .queue-item').forEach((row) => {
      const name = row.querySelector('strong')?.textContent?.trim();
      if (!name || results.some((guest) => guest.name === name)) return;
      const detailText = row.querySelector('small')?.textContent?.trim() || 'Waitlist';
      results.push({ name, detail: detailText, status: 'Waiting' });
    });
    return results;
  };

  const renderGuestSearch = () => {
    const input = document.getElementById('bcHostGuestSearchV100_2_14');
    const output = document.getElementById('bcHostGuestResultsV100_2_14');
    if (!input || !output) return;
    const query = input.value.trim().toLowerCase();
    const guests = collectGuests().filter((guest) => !query || guest.name.toLowerCase().includes(query));
    if (!guests.length) {
      output.innerHTML = '<div class="bc-guest-empty">No matching guest found.</div>';
      return;
    }
    output.innerHTML = guests.map((guest) => `
      <article class="bc-guest-result">
        <div><strong>${guest.name}</strong><span>${guest.detail}</span></div>
        <em>${guest.status}</em>
      </article>
    `).join('');
  };

  const guestInput = document.getElementById('bcHostGuestSearchV100_2_14');
  if (guestInput && !guestInput.dataset.bcBoundV100214) {
    guestInput.dataset.bcBoundV100214 = 'true';
    guestInput.addEventListener('input', renderGuestSearch);
  }

  const activate = (workspaceName) => {
    const name = workspaceName.toLowerCase();
    navButtons.forEach((button) => button.classList.toggle('active', normalizeLabel(button) === name));
    clearTransientFloorUI();
    guestPanel.hidden = true;
    titleStrip.hidden = true;

    if (name === 'floor') {
      hostWorkspace.classList.remove('bc-single-workspace');
      floorPanel.hidden = false;
      queuePanel.hidden = false;
      setTopbar(originalHeading, originalSubtitle);
      forceQueueView('waitlist');
      return;
    }

    hostWorkspace.classList.add('bc-single-workspace');
    floorPanel.hidden = true;

    if (name === 'reservations') {
      queuePanel.hidden = false;
      forceQueueView('arrivals');
      setTitleStrip('Reservations', "Tonight's arrivals", 'Who is coming, what matters, and who is ready to seat.');
      setTopbar('Reservations', 'Tonight · Marina Grille');
      return;
    }

    if (name === 'waitlist') {
      queuePanel.hidden = false;
      forceQueueView('waitlist');
      setTitleStrip('Waitlist', 'Who is waiting', 'Seat the right party quickly. Nothing else competes for attention.');
      setTopbar('Waitlist', 'Live front-door queue · Marina Grille');
      return;
    }

    if (name === 'guests') {
      queuePanel.hidden = true;
      guestPanel.hidden = false;
      setTopbar('Guests', 'Find tonight\'s guest');
      renderGuestSearch();
    }
  };

  if (!window.__bcHostWorkspaceSimplificationV100_2_14) {
    window.__bcHostWorkspaceSimplificationV100_2_14 = true;
    navButtons.forEach((button) => {
      button.addEventListener('click', () => activate(normalizeLabel(button)));
    });
  }

  // Start clean: Floor is the only default workspace and no stale selected-table card survives refresh.
  activate('floor');
})();

// V100.2.15 — Host Stand Readability + Guided Waitlist Seating
(() => {
  const waitlist = document.getElementById('waitlistQueue');
  const arrivals = document.getElementById('arrivalQueue');
  const floorPanel = document.querySelector('.host-floor-panel');
  const floorMap = document.getElementById('hostFloorMap');
  const detail = document.getElementById('hostTableDetail');
  const assignButton = document.getElementById('assignTableButton');
  const navButtons = [...document.querySelectorAll('.host-nav button')];
  if (!waitlist || !arrivals || !floorPanel || !floorMap || !assignButton || !navButtons.length) return;

  const styleId = 'bc-host-readability-guided-seating-v100-2-15';
  if (!document.getElementById(styleId)) {
    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = `
      /* Aim small, miss small: fast scan, obvious action. */
      #waitlistQueue .queue-item,
      #arrivalQueue .queue-item.arrival {
        min-height:96px !important;
        padding:18px 20px !important;
        gap:16px !important;
        border-color:rgba(131,197,187,.30) !important;
        background:#123d4b !important;
      }
      #waitlistQueue .queue-item strong,
      #arrivalQueue .queue-item.arrival strong {
        color:#fff !important;
        font-size:20px !important;
        line-height:1.15 !important;
        font-weight:850 !important;
      }
      #waitlistQueue .queue-item small,
      #arrivalQueue .queue-item.arrival small {
        color:#d4e8e9 !important;
        font-size:16px !important;
        line-height:1.25 !important;
        margin-top:5px !important;
      }
      #waitlistQueue .queue-time,
      #arrivalQueue .arrival-time {
        font-size:16px !important;
        font-weight:900 !important;
        color:#082632 !important;
        background:#f7e7c6 !important;
      }
      #waitlistQueue .queue-item > button,
      #arrivalQueue .bc-arrival-action-v100-2-13 {
        min-width:112px !important;
        min-height:54px !important;
        padding:0 18px !important;
        border-radius:14px !important;
        border:2px solid #47bfd7 !important;
        background:#087694 !important;
        color:#fff !important;
        font-size:16px !important;
        font-weight:900 !important;
        box-shadow:0 8px 20px rgba(0,0,0,.16) !important;
      }
      #waitlistQueue .queue-item > button:disabled {
        border-color:#6f969f !important;
        background:#365f6b !important;
        color:#e5f0f1 !important;
        opacity:1 !important;
      }
      #arrivalQueue .arrival-chip {
        min-width:104px !important;
        padding:10px 14px !important;
        text-align:center !important;
        font-size:14px !important;
        font-weight:900 !important;
        color:#15343c !important;
        background:#edf5f1 !important;
      }
      .queue-tabs button {
        min-height:58px !important;
        padding:0 22px !important;
        font-size:18px !important;
        font-weight:900 !important;
      }
      .bc-waitlist-seat-instruction-v100-2-15 {
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:18px;
        margin:0 0 16px;
        padding:16px 18px;
        border:2px solid #65d3c4;
        border-radius:16px;
        background:#0d4550;
        color:#fff;
        box-shadow:0 10px 28px rgba(0,0,0,.18);
      }
      .bc-waitlist-seat-instruction-v100-2-15 strong { display:block; font-size:21px; line-height:1.1; }
      .bc-waitlist-seat-instruction-v100-2-15 span { display:block; margin-top:4px; color:#c9e6e6; font-size:15px; }
      .bc-waitlist-seat-instruction-v100-2-15 button,
      .bc-waitlist-seat-confirm-v100-2-15 button {
        min-height:48px;
        border-radius:12px;
        padding:0 16px;
        font-weight:900;
      }
      .host-table.bc-seat-choice-v100-2-15 {
        outline:5px solid rgba(101,211,196,.55) !important;
        outline-offset:5px !important;
        cursor:pointer !important;
        transform:scale(1.06);
      }
      .host-table.bc-seat-unavailable-v100-2-15 {
        opacity:.42 !important;
        filter:saturate(.35) !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 {
        position:absolute;
        z-index:40;
        right:22px;
        top:22px;
        width:min(360px,calc(100% - 44px));
        padding:20px;
        border:2px solid #83c5bb;
        border-radius:18px;
        background:#fff;
        color:#15343c;
        box-shadow:0 24px 55px rgba(0,0,0,.24);
      }
      .bc-waitlist-seat-confirm-v100-2-15 small { color:#39717a; font-weight:900; text-transform:uppercase; letter-spacing:.08em; }
      .bc-waitlist-seat-confirm-v100-2-15 strong { display:block; margin:6px 0 4px; font-size:24px; }
      .bc-waitlist-seat-confirm-v100-2-15 p { margin:0 0 16px; font-size:17px; }
      .bc-waitlist-seat-confirm-v100-2-15 .bc-confirm-seat { width:100%; background:#086b84; color:#fff; border:0; font-size:17px; }
      .bc-waitlist-seat-confirm-v100-2-15 .bc-cancel-seat { width:100%; margin-top:8px; background:#edf5f1; color:#15343c; border:1px solid #b5caca; }
      .bc-host-seat-toast-v100-2-15 {
        position:absolute;
        z-index:60;
        right:18px;
        top:18px;
        padding:14px 18px;
        border-radius:14px;
        background:#edf5f1;
        color:#15343c;
        font-weight:900;
        box-shadow:0 14px 34px rgba(0,0,0,.20);
      }
    `;
    document.head.appendChild(style);
  }

  const normalizeLabel = (button) => (button?.textContent || '').replace(/[^a-zA-Z]/g, '').toLowerCase();
  const floorNav = navButtons.find((button) => normalizeLabel(button) === 'floor');
  const tables = () => [...document.querySelectorAll('.host-table')];
  const getTableState = (table) => ['available','reserved','seated','cleaning'].find((name) => table?.classList.contains(name)) || 'selected';
  const numberOf = (table) => table?.dataset?.table || '';
  const numeric = (selector) => Number(document.querySelector(selector)?.textContent || 0);
  const setNumeric = (selector, value) => { const node=document.querySelector(selector); if(node) node.textContent=String(Math.max(0,value)); };

  const pending = window.__bcWaitlistSeatFlowV100_2_15 || { row:null, guestName:'', guestDetail:'', selectedTable:null };
  window.__bcWaitlistSeatFlowV100_2_15 = pending;

  let instruction = document.getElementById('bcWaitlistSeatInstructionV100_2_15');
  if (!instruction) {
    instruction = document.createElement('div');
    instruction.id = 'bcWaitlistSeatInstructionV100_2_15';
    instruction.className = 'bc-waitlist-seat-instruction-v100-2-15';
    instruction.hidden = true;
    instruction.innerHTML = '<div><strong>Choose a table</strong><span>Select an available table to continue.</span></div><button type="button">Cancel</button>';
    floorPanel.insertBefore(instruction, floorPanel.firstChild);
  }

  let confirm = document.getElementById('bcWaitlistSeatConfirmV100_2_15');
  if (!confirm) {
    confirm = document.createElement('div');
    confirm.id = 'bcWaitlistSeatConfirmV100_2_15';
    confirm.className = 'bc-waitlist-seat-confirm-v100-2-15';
    confirm.hidden = true;
    confirm.innerHTML = '<small>Seat guest</small><strong></strong><p></p><button class="bc-confirm-seat" type="button">Confirm seating</button><button class="bc-cancel-seat" type="button">Cancel</button>';
    floorMap.appendChild(confirm);
  }

  const clearAnthonyTransientDetail = () => {
    document.querySelectorAll('.host-table.selected').forEach((table) => table.classList.remove('selected'));
    if (detail) {
      detail.hidden = true;
      detail.setAttribute('aria-hidden','true');
      detail.classList.remove('bc-detail-open');
    }
    window.__bcHostSelectedTableV100_2_13 = null;
    window.__bcHostSelectedTableV100_2_12 = null;
  };

  const resetTableChoiceStyles = () => {
    tables().forEach((table) => table.classList.remove('bc-seat-choice-v100-2-15','bc-seat-unavailable-v100-2-15'));
  };

  const cancelWaitlistSeatFlow = () => {
    pending.row = null;
    pending.guestName = '';
    pending.guestDetail = '';
    pending.selectedTable = null;
    instruction.hidden = true;
    confirm.hidden = true;
    resetTableChoiceStyles();
  };

  const enterTableChoice = (row) => {
    const name = row.querySelector('strong')?.textContent?.trim() || 'Guest';
    const detailText = row.querySelector('small')?.textContent?.trim() || '';
    pending.row = row;
    pending.guestName = name;
    pending.guestDetail = detailText;
    pending.selectedTable = null;
    if (floorNav) floorNav.click();
    clearAnthonyTransientDetail();
    instruction.querySelector('strong').textContent = `Choose a table for ${name}`;
    instruction.querySelector('span').textContent = `${detailText || 'Waiting guest'} · Tap one highlighted table.`;
    instruction.hidden = false;
    confirm.hidden = true;
    tables().forEach((table) => {
      const state = getTableState(table);
      table.classList.toggle('bc-seat-choice-v100-2-15', state === 'available' || state === 'cleaning');
      table.classList.toggle('bc-seat-unavailable-v100-2-15', state !== 'available' && state !== 'cleaning');
    });
  };

  const chooseTable = (table) => {
    if (!pending.row) return;
    const state = getTableState(table);
    if (state !== 'available' && state !== 'cleaning') return;
    pending.selectedTable = table;
    tables().forEach((item) => item.classList.toggle('selected', item === table));
    const number = numberOf(table);
    confirm.querySelector('strong').textContent = `Seat ${pending.guestName} at Table ${number}`;
    confirm.querySelector('p').textContent = `${pending.guestDetail || 'Waiting guest'} · Table ${number} is ${state}.`;
    confirm.querySelector('.bc-confirm-seat').textContent = `Seat ${pending.guestName.split(' ')[0]} at Table ${number}`;
    confirm.hidden = false;
  };

  const showSeatToast = (message) => {
    const toast = document.createElement('div');
    toast.className = 'bc-host-seat-toast-v100-2-15';
    toast.setAttribute('role','status');
    toast.textContent = message;
    floorPanel.appendChild(toast);
    setTimeout(() => toast.remove(), 2200);
  };

  const completeWaitlistSeat = () => {
    const row = pending.row;
    const table = pending.selectedTable;
    if (!row || !table) return;
    const number = numberOf(table);
    const priorState = getTableState(table);
    const name = pending.guestName;

    table.classList.remove('available','cleaning','reserved');
    table.classList.add('seated');
    table.dataset.bcGuestName = name;
    table.dataset.bcGuestStatus = 'seated';
    const small = table.querySelector('small');
    if (small) small.textContent = 'Seated';

    if (priorState === 'available') {
      setNumeric('#availableCount', numeric('#availableCount') - 1);
      setNumeric('#hostOpen', numeric('#hostOpen') - 1);
    }
    if (priorState === 'cleaning') setNumeric('#cleaningCount', numeric('#cleaningCount') - 1);
    setNumeric('#seatedCount', numeric('#seatedCount') + 1);
    setNumeric('#hostSeated', numeric('#hostSeated') + 1);
    setNumeric('#waitlistBadge', numeric('#waitlistBadge') - 1);
    setNumeric('#hostWaiting', numeric('#hostWaiting') - 1);

    row.dataset.bcGuestStatus = 'seated';
    row.dataset.bcTable = number;
    row.remove();
    const recommendation = document.getElementById('hostRecommendation');
    if (recommendation) recommendation.textContent = `${name} seated at Table ${number}`;

    cancelWaitlistSeatFlow();
    clearAnthonyTransientDetail();
    showSeatToast(`${name} seated at Table ${number}`);
  };

  // Capture Seat before older generic handlers can mark a guest seated without a table.
  if (!waitlist.dataset.bcGuidedSeatBoundV100215) {
    waitlist.dataset.bcGuidedSeatBoundV100215 = 'true';
    waitlist.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      const row = button?.closest('.queue-item');
      if (!button || !row || button.disabled) return;
      const label = button.textContent.trim().toLowerCase();
      if (label !== 'seat') return;
      event.preventDefault();
      event.stopImmediatePropagation();
      enterTableChoice(row);
    }, true);
  }

  // While choosing a table for a waitlist guest, table taps belong only to that guest flow.
  if (!floorMap.dataset.bcGuidedTableBoundV100215) {
    floorMap.dataset.bcGuidedTableBoundV100215 = 'true';
    floorMap.addEventListener('click', (event) => {
      if (!pending.row) return;
      const table = event.target.closest('.host-table');
      if (!table) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      chooseTable(table);
    }, true);
  }

  instruction.querySelector('button')?.addEventListener('click', cancelWaitlistSeatFlow);
  confirm.querySelector('.bc-cancel-seat')?.addEventListener('click', cancelWaitlistSeatFlow);
  confirm.querySelector('.bc-confirm-seat')?.addEventListener('click', completeWaitlistSeat);

  // Expected reservation hold is a completed action: collapse the card immediately after reserve.
  if (!assignButton.dataset.bcReserveCollapseBoundV100215) {
    assignButton.dataset.bcReserveCollapseBoundV100215 = 'true';
    assignButton.addEventListener('click', () => {
      setTimeout(() => {
        const assignment = window.__bcHostAssignmentV100_2_13;
        const state = assignButton.dataset.bcAssignmentState;
        if (assignment?.status === 'assigned' && state === 'held' && detail) {
          detail.hidden = true;
          detail.setAttribute('aria-hidden','true');
          detail.classList.remove('bc-detail-open');
          document.querySelectorAll('.host-table.selected').forEach((table) => table.classList.remove('selected'));
          window.__bcHostSelectedTableV100_2_13 = null;
        }
      }, 0);
    });
  }
})();

// V100.2.16 — Generic Guest Action Context + Host Stand Contrast Polish
(() => {
  const hostWorkspace = document.querySelector('.host-workspace');
  const floorPanel = document.querySelector('.host-floor-panel');
  const floorMap = document.getElementById('hostFloorMap');
  const waitlist = document.getElementById('waitlistQueue');
  const arrivals = document.getElementById('arrivalQueue');
  const detail = document.getElementById('hostTableDetail');
  const assignButton = document.getElementById('assignTableButton');
  const navButtons = [...document.querySelectorAll('.host-nav button')];
  if (!hostWorkspace || !floorPanel || !floorMap || !waitlist || !arrivals || !navButtons.length) return;

  const styleId = 'bc-generic-guest-context-v100-2-16';
  if (!document.getElementById(styleId)) {
    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = `
      /* Aim small, miss small: no pale controls, no mystery state, no demo-only guest context. */
      .bc-waitlist-seat-confirm-v100-2-15 {
        background:#ffffff !important;
        color:#102f39 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 small {
        color:#315d66 !important;
        font-size:14px !important;
        font-weight:950 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 strong {
        color:#102f39 !important;
        font-size:24px !important;
        font-weight:950 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 p {
        color:#355b63 !important;
        font-size:17px !important;
        font-weight:700 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 .bc-confirm-seat {
        background:#087694 !important;
        color:#fff !important;
        border:2px solid #075f77 !important;
        font-weight:950 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 .bc-cancel-seat,
      .bc-waitlist-seat-instruction-v100-2-15 > button {
        background:#f7f1e7 !important;
        color:#102f39 !important;
        border:2px solid #9eb5b9 !important;
        font-size:16px !important;
        font-weight:950 !important;
        opacity:1 !important;
      }
      .bc-waitlist-seat-instruction-v100-2-15 > button:hover,
      .bc-waitlist-seat-confirm-v100-2-15 .bc-cancel-seat:hover {
        background:#fff !important;
        border-color:#5e858d !important;
      }
      #waitlistQueue .queue-item,
      #arrivalQueue .queue-item.arrival,
      .bc-guest-result,
      .bc-host-clickable-party-v100-2-16 {
        cursor:pointer !important;
      }
      #waitlistQueue .queue-item:focus-visible,
      #arrivalQueue .queue-item.arrival:focus-visible,
      .bc-guest-result:focus-visible,
      .bc-host-clickable-party-v100-2-16:focus-visible {
        outline:4px solid #65d3c4 !important;
        outline-offset:3px !important;
      }
      .bc-party-dialog-backdrop-v100-2-16 {
        position:fixed;
        inset:0;
        z-index:2500;
        display:grid;
        place-items:center;
        padding:24px;
        background:rgba(2,18,24,.72);
        backdrop-filter:blur(5px);
      }
      .bc-party-dialog-backdrop-v100-2-16[hidden] { display:none !important; }
      .bc-party-dialog-v100-2-16 {
        width:min(560px,100%);
        max-height:min(760px,92vh);
        overflow:auto;
        border:2px solid #79cabe;
        border-radius:22px;
        background:#fff;
        color:#102f39;
        box-shadow:0 30px 90px rgba(0,0,0,.38);
      }
      .bc-party-dialog-head-v100-2-16 {
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:16px;
        padding:22px 24px 18px;
        border-bottom:1px solid #d8e4e5;
      }
      .bc-party-dialog-head-v100-2-16 small {
        display:block;
        color:#087694;
        font-weight:950;
        text-transform:uppercase;
        letter-spacing:.12em;
      }
      .bc-party-dialog-head-v100-2-16 h3 {
        margin:5px 0 0;
        color:#102f39;
        font-size:28px;
        line-height:1.05;
      }
      .bc-party-dialog-close-v100-2-16 {
        width:48px;
        height:48px;
        flex:0 0 48px;
        border:2px solid #9eb5b9;
        border-radius:50%;
        background:#f7f1e7;
        color:#102f39;
        font-size:23px;
        font-weight:950;
      }
      .bc-party-dialog-body-v100-2-16 { padding:22px 24px 24px; }
      .bc-party-status-v100-2-16 {
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:12px;
        margin-bottom:18px;
        padding:14px 16px;
        border-radius:14px;
        background:#eaf4f1;
      }
      .bc-party-status-v100-2-16 strong { color:#102f39; font-size:17px; }
      .bc-party-status-v100-2-16 span {
        padding:7px 11px;
        border-radius:999px;
        background:#fff;
        color:#174b56;
        font-weight:950;
      }
      .bc-party-form-v100-2-16 { display:grid; gap:14px; }
      .bc-party-form-v100-2-16 label { display:grid; gap:6px; color:#315d66; font-size:14px; font-weight:900; }
      .bc-party-form-v100-2-16 input,
      .bc-party-form-v100-2-16 textarea {
        width:100%;
        border:2px solid #a8c4c8;
        border-radius:12px;
        background:#fff;
        color:#102f39;
        padding:12px 14px;
        font:inherit;
        font-size:17px;
        font-weight:750;
        outline:none;
      }
      .bc-party-form-v100-2-16 input:focus,
      .bc-party-form-v100-2-16 textarea:focus { border-color:#087694; box-shadow:0 0 0 3px rgba(8,118,148,.15); }
      .bc-party-form-v100-2-16 textarea { min-height:82px; resize:vertical; }
      .bc-party-actions-v100-2-16 { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:18px; }
      .bc-party-actions-v100-2-16 button {
        min-height:52px;
        border-radius:12px;
        border:2px solid #9eb5b9;
        background:#f7f1e7;
        color:#102f39;
        font-size:16px;
        font-weight:950;
      }
      .bc-party-actions-v100-2-16 .primary {
        grid-column:1 / -1;
        border-color:#087694;
        background:#087694;
        color:#fff;
      }
      .bc-party-actions-v100-2-16 .secondary-strong {
        border-color:#2d7888;
        background:#e6f2f3;
        color:#103945;
      }
      .bc-active-party-banner-v100-2-16 {
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:18px;
        margin:0 0 16px;
        padding:16px 18px;
        border:2px solid #65d3c4;
        border-radius:16px;
        background:#0d4550;
        color:#fff;
        box-shadow:0 10px 28px rgba(0,0,0,.18);
      }
      .bc-active-party-banner-v100-2-16 strong { display:block; font-size:21px; line-height:1.1; }
      .bc-active-party-banner-v100-2-16 span { display:block; margin-top:4px; color:#d5eeee; font-size:15px; }
      .bc-active-party-banner-v100-2-16 button {
        min-height:48px;
        padding:0 17px;
        border:2px solid #9eb5b9;
        border-radius:12px;
        background:#f7f1e7;
        color:#102f39;
        font-size:16px;
        font-weight:950;
      }
      .host-table.bc-active-party-choice-v100-2-16 {
        outline:5px solid rgba(101,211,196,.65) !important;
        outline-offset:5px !important;
        cursor:pointer !important;
        transform:scale(1.06);
      }
      .host-table.bc-active-party-unavailable-v100-2-16 { opacity:.38 !important; filter:saturate(.35) !important; }
      .bc-active-party-confirm-v100-2-16 {
        position:absolute;
        z-index:75;
        right:22px;
        top:22px;
        width:min(380px,calc(100% - 44px));
        padding:20px;
        border:2px solid #65cbbc;
        border-radius:18px;
        background:#fff;
        color:#102f39;
        box-shadow:0 24px 60px rgba(0,0,0,.28);
      }
      .bc-active-party-confirm-v100-2-16[hidden] { display:none !important; }
      .bc-active-party-confirm-v100-2-16 small { color:#315d66; font-weight:950; text-transform:uppercase; letter-spacing:.08em; }
      .bc-active-party-confirm-v100-2-16 strong { display:block; margin:7px 0 6px; color:#102f39; font-size:24px; line-height:1.1; }
      .bc-active-party-confirm-v100-2-16 p { margin:0 0 16px; color:#355b63; font-size:16px; font-weight:700; }
      .bc-active-party-confirm-v100-2-16 button { width:100%; min-height:52px; border-radius:12px; font-size:16px; font-weight:950; }
      .bc-active-party-confirm-v100-2-16 .bc-active-confirm-primary { border:2px solid #087694; background:#087694; color:#fff; }
      .bc-active-party-confirm-v100-2-16 .bc-active-confirm-cancel { margin-top:8px; border:2px solid #9eb5b9; background:#f7f1e7; color:#102f39; }
      .bc-neutral-table-detail-v100-2-16 { color:#102f39 !important; }
      .bc-neutral-table-detail-v100-2-16 p { color:#315d66 !important; font-weight:700 !important; }
    `;
    document.head.appendChild(style);
  }

  const normalize = (value) => String(value || '').trim();
  const normalizeStatus = (value) => {
    const text = normalize(value).toLowerCase();
    if (text.includes('seated')) return 'seated';
    if (text.includes('arrived')) return 'arrived';
    if (text.includes('expected')) return 'expected';
    if (text.includes('waiting') || text.includes('waitlist')) return 'waiting';
    return text || 'guest';
  };
  const navLabel = (button) => normalize(button?.textContent).replace(/[^a-zA-Z]/g,'').toLowerCase();
  const floorNav = navButtons.find((button) => navLabel(button) === 'floor');
  const tables = () => [...document.querySelectorAll('.host-table')];
  const tableNumber = (table) => normalize(table?.dataset?.table);
  const tableState = (table) => ['available','reserved','seated','cleaning'].find((state) => table?.classList.contains(state)) || 'selected';
  const numberValue = (selector) => Number(document.querySelector(selector)?.textContent || 0);
  const setNumber = (selector, value) => { const node=document.querySelector(selector); if(node) node.textContent=String(Math.max(0,value)); };

  const state = window.__bcGenericGuestContextV100_2_16 || {
    activeParty:null,
    mode:null,
    selectedTable:null,
    returnFocus:null
  };
  window.__bcGenericGuestContextV100_2_16 = state;

  let dialogBackdrop = document.getElementById('bcPartyDialogBackdropV100_2_16');
  if (!dialogBackdrop) {
    dialogBackdrop = document.createElement('div');
    dialogBackdrop.id = 'bcPartyDialogBackdropV100_2_16';
    dialogBackdrop.className = 'bc-party-dialog-backdrop-v100-2-16';
    dialogBackdrop.hidden = true;
    dialogBackdrop.innerHTML = `
      <section class="bc-party-dialog-v100-2-16" role="dialog" aria-modal="true" aria-labelledby="bcPartyDialogTitleV100_2_16">
        <div class="bc-party-dialog-head-v100-2-16">
          <div><small id="bcPartyDialogKickerV100_2_16">Guest</small><h3 id="bcPartyDialogTitleV100_2_16">Guest details</h3></div>
          <button class="bc-party-dialog-close-v100-2-16" type="button" aria-label="Close guest details">×</button>
        </div>
        <div class="bc-party-dialog-body-v100-2-16">
          <div class="bc-party-status-v100-2-16"><strong id="bcPartyDialogSummaryV100_2_16"></strong><span id="bcPartyDialogStatusV100_2_16"></span></div>
          <div class="bc-party-form-v100-2-16">
            <label>Guest name<input id="bcPartyNameV100_2_16" type="text" autocomplete="off"></label>
            <label>Party size<input id="bcPartySizeV100_2_16" type="number" min="1" max="40" inputmode="numeric"></label>
            <label>Notes / preference<textarea id="bcPartyDetailV100_2_16"></textarea></label>
          </div>
          <div class="bc-party-actions-v100-2-16">
            <button id="bcPartySaveV100_2_16" type="button" class="secondary-strong">Save changes</button>
            <button id="bcPartySecondaryV100_2_16" type="button">Close</button>
            <button id="bcPartyPrimaryV100_2_16" type="button" class="primary">Done</button>
          </div>
        </div>
      </section>`;
    document.body.appendChild(dialogBackdrop);
  }

  let activeBanner = document.getElementById('bcActivePartyBannerV100_2_16');
  if (!activeBanner) {
    activeBanner = document.createElement('div');
    activeBanner.id = 'bcActivePartyBannerV100_2_16';
    activeBanner.className = 'bc-active-party-banner-v100-2-16';
    activeBanner.hidden = true;
    activeBanner.innerHTML = '<div><strong></strong><span></span></div><button type="button">Cancel</button>';
    floorPanel.insertBefore(activeBanner, floorPanel.firstChild);
  }

  let activeConfirm = document.getElementById('bcActivePartyConfirmV100_2_16');
  if (!activeConfirm) {
    activeConfirm = document.createElement('div');
    activeConfirm.id = 'bcActivePartyConfirmV100_2_16';
    activeConfirm.className = 'bc-active-party-confirm-v100-2-16';
    activeConfirm.hidden = true;
    activeConfirm.innerHTML = '<small>Confirm</small><strong></strong><p></p><button class="bc-active-confirm-primary" type="button">Confirm</button><button class="bc-active-confirm-cancel" type="button">Cancel</button>';
    floorMap.appendChild(activeConfirm);
  }

  const dialog = {
    kicker: document.getElementById('bcPartyDialogKickerV100_2_16'),
    title: document.getElementById('bcPartyDialogTitleV100_2_16'),
    summary: document.getElementById('bcPartyDialogSummaryV100_2_16'),
    status: document.getElementById('bcPartyDialogStatusV100_2_16'),
    name: document.getElementById('bcPartyNameV100_2_16'),
    size: document.getElementById('bcPartySizeV100_2_16'),
    detail: document.getElementById('bcPartyDetailV100_2_16'),
    save: document.getElementById('bcPartySaveV100_2_16'),
    secondary: document.getElementById('bcPartySecondaryV100_2_16'),
    primary: document.getElementById('bcPartyPrimaryV100_2_16'),
    close: dialogBackdrop.querySelector('.bc-party-dialog-close-v100-2-16')
  };

  const parsePartySize = (text) => Number(normalize(text).match(/party\s+of\s+(\d+)/i)?.[1] || 2);
  const replacePartySize = (text, size) => {
    const source = normalize(text) || `Party of ${size}`;
    return /party\s+of\s+\d+/i.test(source) ? source.replace(/party\s+of\s+\d+/i, `Party of ${size}`) : `Party of ${size}${source ? ` · ${source}` : ''}`;
  };

  const statusNodeFor = (row) => {
    if (!row) return null;
    const direct = row.querySelector('.arrival-chip, em, [data-bc-status], .status-chip, .guest-status');
    if (direct) return direct;
    return [...row.querySelectorAll('span,button')].find((node) => /^(expected|arrived|waiting|seated(?:\s*·.*)?)$/i.test(normalize(node.textContent))) || null;
  };

  const rowsForName = (name) => [...document.querySelectorAll('.host-workspace article, .bc-guest-result')].filter((row) => {
    const strong = row.querySelector('strong');
    return normalize(strong?.textContent) === name;
  });

  const sourceTypeFor = (row) => {
    if (!row) return 'guest';
    if (row.closest('#waitlistQueue')) return 'waitlist';
    if (row.closest('#arrivalQueue')) return 'reservation';
    if (row.classList.contains('bc-guest-result')) return 'guest';
    const text = normalize(row.textContent).toLowerCase();
    if (text.includes('expected') || text.includes('arrived') || text.includes('reservation')) return 'reservation';
    if (text.includes('waiting') || text.includes('waitlist')) return 'waitlist';
    return 'guest';
  };

  const partyFromRow = (row) => {
    const name = normalize(row?.querySelector('strong')?.textContent);
    if (!name) return null;
    const detailNode = row.querySelector('small') || [...row.querySelectorAll('span')].find((node) => /party\s+of\s+\d+/i.test(normalize(node.textContent)));
    const detailText = normalize(detailNode?.textContent) || 'Party of 2';
    const statusText = normalize(statusNodeFor(row)?.textContent) || (row.closest('#waitlistQueue') ? 'Waiting' : 'Guest');
    const tableFromStatus = statusText.match(/table\s+(\d+)/i)?.[1] || row.dataset.bcTable || '';
    return {
      name,
      originalName:name,
      partySize:parsePartySize(detailText),
      detail:detailText,
      status:normalizeStatus(statusText),
      statusText,
      tableNumber:tableFromStatus,
      sourceType:sourceTypeFor(row),
      sourceRow:row
    };
  };

  const findBestRow = (name, preferredType) => {
    const rows = rowsForName(name);
    return rows.find((row) => sourceTypeFor(row) === preferredType) || rows[0] || null;
  };

  const refreshGuestSearch = () => {
    const input = document.getElementById('bcHostGuestSearchV100_2_14');
    if (input) input.dispatchEvent(new Event('input', {bubbles:true}));
  };

  const updateStatusEverywhere = (name, status, tableNumberValue='') => {
    rowsForName(name).forEach((row) => {
      row.dataset.bcGuestStatus = status;
      if (tableNumberValue) row.dataset.bcTable = tableNumberValue;
      else if (status !== 'seated') row.removeAttribute('data-bc-table');
      const node = statusNodeFor(row);
      if (node) {
        node.textContent = status === 'seated' ? `Seated · Table ${tableNumberValue}` : status.charAt(0).toUpperCase()+status.slice(1);
        if (node.classList.contains('arrival-chip')) {
          node.classList.toggle('pending', status === 'expected');
          node.classList.toggle('bc-seated-table', status === 'seated');
        }
      }
      const markAction = row.querySelector('.bc-arrival-action-v100-2-13');
      if (markAction) markAction.hidden = status !== 'expected';
    });
    refreshGuestSearch();
  };

  const updatePartyEverywhere = (oldName, newName, partySizeValue, detailText) => {
    const rows = rowsForName(oldName);
    rows.forEach((row) => {
      const strong = row.querySelector('strong');
      if (strong) strong.textContent = newName;
      const detailNode = row.querySelector('small') || [...row.querySelectorAll('span')].find((node) => /party\s+of\s+\d+/i.test(normalize(node.textContent)));
      if (detailNode) detailNode.textContent = replacePartySize(detailText, partySizeValue);
    });
    tables().forEach((table) => { if (table.dataset.bcGuestName === oldName) table.dataset.bcGuestName = newName; });
    refreshGuestSearch();
  };

  const closeDialog = () => {
    dialogBackdrop.hidden = true;
    state.activeParty = null;
    if (state.returnFocus && document.contains(state.returnFocus)) state.returnFocus.focus?.();
    state.returnFocus = null;
  };

  const renderDialogActions = () => {
    const party = state.activeParty;
    if (!party) return;
    const status = normalizeStatus(party.status);
    dialog.kicker.textContent = party.sourceType === 'waitlist' ? 'Waitlist' : party.sourceType === 'reservation' ? 'Reservation' : 'Guest';
    dialog.title.textContent = party.name;
    dialog.summary.textContent = `Party of ${party.partySize}${party.tableNumber ? ` · Table ${party.tableNumber}` : ''}`;
    dialog.status.textContent = status.charAt(0).toUpperCase()+status.slice(1);
    dialog.name.value = party.name;
    dialog.size.value = String(party.partySize || 2);
    dialog.detail.value = party.detail || `Party of ${party.partySize || 2}`;

    dialog.primary.hidden = false;
    dialog.secondary.hidden = false;
    dialog.secondary.textContent = 'Close';
    dialog.secondary.classList.remove('secondary-strong');

    if (status === 'waiting') {
      dialog.primary.textContent = 'Seat guest';
    } else if (status === 'expected') {
      dialog.primary.textContent = 'Mark arrived';
      dialog.secondary.textContent = 'Reserve a table';
      dialog.secondary.classList.add('secondary-strong');
    } else if (status === 'arrived') {
      dialog.primary.textContent = 'Seat guest';
    } else if (status === 'seated') {
      dialog.primary.textContent = party.tableNumber ? `Open Table ${party.tableNumber}` : 'Done';
    } else {
      dialog.primary.textContent = 'Done';
    }
  };

  const openPartyDialog = (row) => {
    const party = partyFromRow(row);
    if (!party) return;
    state.activeParty = party;
    state.returnFocus = document.activeElement;
    renderDialogActions();
    dialogBackdrop.hidden = false;
    dialog.name.focus();
  };

  const clearTableChoiceStyles = () => {
    tables().forEach((table) => table.classList.remove('bc-active-party-choice-v100-2-16','bc-active-party-unavailable-v100-2-16','selected'));
  };

  const cancelActivePartyFlow = () => {
    state.mode = null;
    state.selectedTable = null;
    state.activeParty = null;
    activeBanner.hidden = true;
    activeConfirm.hidden = true;
    clearTableChoiceStyles();
  };

  const canUseTable = (table, party) => {
    const status = tableState(table);
    if (status === 'available' || status === 'cleaning') return true;
    if (status === 'reserved' && normalize(table.dataset.bcGuestName) === party.name) return true;
    return false;
  };

  const beginTableChoice = (party, mode) => {
    state.activeParty = {...party};
    state.mode = mode;
    state.selectedTable = null;
    dialogBackdrop.hidden = true;
    if (floorNav) floorNav.click();
    // V100.2.15 has its own waitlist banner. Hide it while V100.2.16 owns the task.
    const oldBanner = document.getElementById('bcWaitlistSeatInstructionV100_2_15');
    const oldConfirm = document.getElementById('bcWaitlistSeatConfirmV100_2_15');
    if (oldBanner) oldBanner.hidden = true;
    if (oldConfirm) oldConfirm.hidden = true;
    if (detail) { detail.hidden = true; detail.setAttribute('aria-hidden','true'); detail.classList.remove('bc-detail-open'); }
    if (assignButton) { assignButton.hidden = true; assignButton.disabled = true; }
    activeBanner.querySelector('strong').textContent = mode === 'reserve' ? `Choose a table to hold for ${party.name}` : `Choose a table for ${party.name}`;
    activeBanner.querySelector('span').textContent = `Party of ${party.partySize} · Tap one highlighted table.`;
    activeBanner.hidden = false;
    activeConfirm.hidden = true;
    tables().forEach((table) => {
      const usable = canUseTable(table, party);
      table.classList.toggle('bc-active-party-choice-v100-2-16', usable);
      table.classList.toggle('bc-active-party-unavailable-v100-2-16', !usable);
    });
  };

  const chooseActiveTable = (table) => {
    const party = state.activeParty;
    if (!party || !state.mode || !canUseTable(table, party)) return;
    state.selectedTable = table;
    tables().forEach((item) => item.classList.toggle('selected', item === table));
    const number = tableNumber(table);
    const verb = state.mode === 'reserve' ? 'Reserve' : 'Seat';
    activeConfirm.querySelector('strong').textContent = `${verb} ${party.name} at Table ${number}`;
    activeConfirm.querySelector('p').textContent = `Party of ${party.partySize} · Table ${number} is ${tableState(table)}.`;
    activeConfirm.querySelector('.bc-active-confirm-primary').textContent = `${verb} ${party.name.split(' ')[0]} at Table ${number}`;
    activeConfirm.hidden = false;
  };

  const showToast = (message) => {
    const toast = document.createElement('div');
    toast.className = 'bc-host-seat-toast-v100-2-15';
    toast.setAttribute('role','status');
    toast.textContent = message;
    floorPanel.appendChild(toast);
    setTimeout(() => toast.remove(), 2200);
  };

  const completeActivePartyTableAction = () => {
    const party = state.activeParty;
    const table = state.selectedTable;
    const mode = state.mode;
    if (!party || !table || !mode) return;
    const number = tableNumber(table);
    const prior = tableState(table);

    if (mode === 'reserve') {
      if (prior === 'available') { setNumber('#availableCount', numberValue('#availableCount')-1); setNumber('#hostOpen', numberValue('#hostOpen')-1); }
      if (prior === 'cleaning') setNumber('#cleaningCount', numberValue('#cleaningCount')-1);
      if (prior !== 'reserved') setNumber('#reservedCount', numberValue('#reservedCount')+1);
      table.classList.remove('available','cleaning','seated');
      table.classList.add('reserved');
      table.dataset.bcGuestName = party.name;
      table.dataset.bcGuestStatus = 'assigned';
      table.dataset.bcPriorTableState = prior;
      const small = table.querySelector('small');
      if (small) small.textContent = 'Held';
      rowsForName(party.name).forEach((row) => row.dataset.bcHeldTable = number);
      const recommendation = document.getElementById('hostRecommendation');
      if (recommendation) recommendation.textContent = `Table ${number} held for ${party.name}`;
      cancelActivePartyFlow();
      showToast(`Table ${number} held for ${party.name}`);
      return;
    }

    if (prior === 'available') { setNumber('#availableCount', numberValue('#availableCount')-1); setNumber('#hostOpen', numberValue('#hostOpen')-1); }
    if (prior === 'cleaning') setNumber('#cleaningCount', numberValue('#cleaningCount')-1);
    if (prior === 'reserved') setNumber('#reservedCount', numberValue('#reservedCount')-1);
    setNumber('#seatedCount', numberValue('#seatedCount')+1);
    setNumber('#hostSeated', numberValue('#hostSeated')+1);

    table.classList.remove('available','cleaning','reserved');
    table.classList.add('seated');
    table.dataset.bcGuestName = party.name;
    table.dataset.bcGuestStatus = 'seated';
    table.dataset.bcTable = number;
    const small = table.querySelector('small');
    if (small) small.textContent = 'Seated';
    updateStatusEverywhere(party.name, 'seated', number);
    const recommendation = document.getElementById('hostRecommendation');
    if (recommendation) recommendation.textContent = `${party.name} seated at Table ${number}`;
    cancelActivePartyFlow();
    showToast(`${party.name} seated at Table ${number}`);
  };

  const showNeutralTableDetail = (table) => {
    if (!detail) return;
    const number = tableNumber(table);
    const status = tableState(table);
    const guest = normalize(table.dataset.bcGuestName);
    tables().forEach((item) => item.classList.toggle('selected', item === table));
    const headStrong = detail.querySelector('.host-table-detail-head strong') || detail.querySelector('strong');
    if (headStrong) headStrong.textContent = `Table ${number}`;
    const chip = detail.querySelector('.cleaning-chip');
    if (chip) chip.textContent = status.charAt(0).toUpperCase()+status.slice(1);
    const grid = detail.querySelector('.host-table-detail-grid');
    if (grid) {
      const cells = [...grid.querySelectorAll('div')];
      if (cells[0]) { cells[0].querySelector('span') && (cells[0].querySelector('span').textContent='Seats'); }
      if (cells[1]) { cells[1].querySelector('span') && (cells[1].querySelector('span').textContent='Status'); cells[1].querySelector('strong') && (cells[1].querySelector('strong').textContent=status); }
      if (cells[2]) { cells[2].querySelector('span') && (cells[2].querySelector('span').textContent='Current guest'); cells[2].querySelector('strong') && (cells[2].querySelector('strong').textContent=guest || '—'); }
    }
    const paragraph = detail.querySelector('p');
    if (paragraph) paragraph.textContent = guest ? `${guest} is attached to Table ${number}.` : `Table ${number} is ${status}. Select a guest first to reserve or seat.`;
    detail.classList.add('bc-neutral-table-detail-v100-2-16','bc-detail-open');
    detail.hidden = false;
    detail.removeAttribute('aria-hidden');
    if (assignButton) { assignButton.hidden = true; assignButton.disabled = true; }
  };

  const savePartyChanges = () => {
    const party = state.activeParty;
    if (!party) return;
    const oldName = party.name;
    const newName = normalize(dialog.name.value) || oldName;
    const newSize = Math.max(1, Number(dialog.size.value || party.partySize || 2));
    const newDetail = normalize(dialog.detail.value) || `Party of ${newSize}`;
    updatePartyEverywhere(oldName, newName, newSize, newDetail);
    party.name = newName;
    party.partySize = newSize;
    party.detail = replacePartySize(newDetail, newSize);
    party.originalName = newName;
    renderDialogActions();
    showToast(`${newName} updated`);
  };

  dialog.save.addEventListener('click', savePartyChanges);
  dialog.close.addEventListener('click', closeDialog);
  dialogBackdrop.addEventListener('click', (event) => { if (event.target === dialogBackdrop) closeDialog(); });

  dialog.secondary.addEventListener('click', () => {
    const party = state.activeParty;
    if (!party) return closeDialog();
    if (normalizeStatus(party.status) === 'expected' && dialog.secondary.textContent.toLowerCase().includes('reserve')) {
      beginTableChoice(party, 'reserve');
    } else closeDialog();
  });

  dialog.primary.addEventListener('click', () => {
    const party = state.activeParty;
    if (!party) return;
    const status = normalizeStatus(party.status);

    if (status === 'waiting') {
      const liveRow = findBestRow(party.name, 'waitlist');
      closeDialog();
      const seatButton = liveRow ? [...liveRow.querySelectorAll('button')].find((button) => normalize(button.textContent).toLowerCase() === 'seat') : null;
      if (seatButton) seatButton.click();
      return;
    }

    if (status === 'expected') {
      party.status = 'arrived';
      party.statusText = 'Arrived';
      updateStatusEverywhere(party.name, 'arrived');
      renderDialogActions();
      return;
    }

    if (status === 'arrived') {
      beginTableChoice(party, 'seat');
      return;
    }

    if (status === 'seated' && party.tableNumber) {
      const table = tables().find((item) => tableNumber(item) === String(party.tableNumber));
      closeDialog();
      if (floorNav) floorNav.click();
      if (table) showNeutralTableDetail(table);
      return;
    }

    closeDialog();
  });

  activeBanner.querySelector('button').addEventListener('click', cancelActivePartyFlow);
  activeConfirm.querySelector('.bc-active-confirm-cancel').addEventListener('click', cancelActivePartyFlow);
  activeConfirm.querySelector('.bc-active-confirm-primary').addEventListener('click', completeActivePartyTableAction);

  // Make guest-like rows discoverable and operable without tiny target hunting.
  const markClickableRows = () => {
    [...hostWorkspace.querySelectorAll('article, .bc-guest-result')].forEach((row) => {
      const strong = row.querySelector('strong');
      if (!strong || !/party\s+of\s+\d+/i.test(normalize(row.textContent))) return;
      row.classList.add('bc-host-clickable-party-v100-2-16');
      if (!row.hasAttribute('tabindex')) row.tabIndex = 0;
    });
  };
  markClickableRows();
  const observer = new MutationObserver(markClickableRows);
  observer.observe(hostWorkspace, {childList:true,subtree:true});

  // Generic row/details opening. Preserve dedicated Seat buttons and other primary actions.
  hostWorkspace.addEventListener('click', (event) => {
    const row = event.target.closest('article, .bc-guest-result');
    if (!row || !hostWorkspace.contains(row) || !/party\s+of\s+\d+/i.test(normalize(row.textContent))) return;
    const button = event.target.closest('button');
    if (button) {
      const label = normalize(button.textContent).toLowerCase();
      if (label === 'seat' || label.includes('mark arrived')) return;
      if (!(label.includes('detail') || label.includes('view'))) return;
      event.preventDefault();
      event.stopImmediatePropagation();
    }
    openPartyDialog(row);
  }, true);

  hostWorkspace.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const row = event.target.closest('.bc-host-clickable-party-v100-2-16');
    if (!row || event.target.closest('button,input,textarea')) return;
    event.preventDefault();
    openPartyDialog(row);
  });

  // Floor tables are neutral unless a guest workflow explicitly owns them.
  // Capture prevents the older Anthony-specific demo handler from leaking into generic operation.
  floorMap.addEventListener('click', (event) => {
    const table = event.target.closest('.host-table');
    if (!table) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    if (state.activeParty && state.mode) chooseActiveTable(table);
    else showNeutralTableDetail(table);
  }, true);

  // Keep V100.2.15 waitlist flow intact. When its guided flow begins, V100.2.16 does not compete.
  waitlist.addEventListener('click', (event) => {
    const seat = event.target.closest('button');
    const row = seat?.closest('.queue-item');
    if (!seat || !row || normalize(seat.textContent).toLowerCase() !== 'seat') return;
    state.activeParty = null;
    state.mode = null;
    activeBanner.hidden = true;
    activeConfirm.hidden = true;
  }, true);

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!dialogBackdrop.hidden) closeDialog();
    else if (state.mode) cancelActivePartyFlow();
  });
})();

// V100.2.17 — Arrival Check-In + Priority Seating Queue
(() => {
  const hostWorkspace = document.querySelector('.host-workspace');
  const waitlist = document.getElementById('waitlistQueue');
  const arrivals = document.getElementById('arrivalQueue');
  if (!hostWorkspace || !waitlist || !arrivals) return;

  const normalize = (value) => String(value || '').replace(/\s+/g, ' ').trim();
  const lower = (value) => normalize(value).toLowerCase();
  const firstStrong = (row) => normalize(row?.querySelector('strong')?.textContent);
  const partyDetail = (row) => normalize(row?.querySelector('small')?.textContent) || normalize([...row?.querySelectorAll?.('span') || []].find((n) => /party\s+of\s+\d+/i.test(normalize(n.textContent)))?.textContent);
  const statusNode = (row) => row?.querySelector('.arrival-chip, [data-bc-status], .status-chip, .guest-status') || [...(row?.querySelectorAll?.('span,button') || [])].find((n) => /^(expected|arrived|waiting|seated(?:\s*·.*)?)$/i.test(normalize(n.textContent)));
  const getStatus = (row) => lower(statusNode(row)?.textContent || row?.dataset?.bcGuestStatus || '');
  const specialKeywords = ['birthday','anniversary','allergy','allergic','vip','wheelchair','accessibility','accessible','high chair','highchair','celebration','special occasion'];
  const specialLabelFor = (text) => {
    const src = lower(text);
    if (src.includes('birthday')) return 'Birthday';
    if (src.includes('anniversary')) return 'Anniversary';
    if (src.includes('allerg')) return 'Allergy';
    if (src.includes('wheelchair') || src.includes('accessib')) return 'Accessibility';
    if (src.includes('high chair') || src.includes('highchair')) return 'High chair';
    if (src.includes('vip')) return 'VIP';
    if (src.includes('celebration') || src.includes('special occasion')) return 'Special occasion';
    return '';
  };
  const isSpecial = (row) => specialKeywords.some((key) => lower(row?.textContent).includes(key));

  const styleId = 'bc-arrival-priority-v100-2-17';
  if (!document.getElementById(styleId)) {
    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = `
      /* Aim small, miss small: Arrivals = not here yet. Waitlist = physically here and ready to seat. */
      #bcActivePartyBannerV100_2_16.bc-empty-banner-v100-2-17 { display:none !important; }
      #arrivalQueue .queue-item.arrival,
      #waitlistQueue .queue-item {
        min-height:112px !important;
        padding:20px 18px !important;
        gap:16px !important;
        align-items:center !important;
      }
      #arrivalQueue .queue-item.arrival strong,
      #waitlistQueue .queue-item strong {
        color:#fff !important;
        font-size:22px !important;
        line-height:1.05 !important;
        font-weight:950 !important;
      }
      #arrivalQueue .queue-item.arrival small,
      #waitlistQueue .queue-item small {
        display:block !important;
        margin-top:5px !important;
        color:#d7f0f2 !important;
        font-size:16px !important;
        line-height:1.25 !important;
        font-weight:750 !important;
      }
      #arrivalQueue .arrival-time,
      #waitlistQueue .queue-time {
        color:#102f39 !important;
        background:#fff3d9 !important;
        font-size:16px !important;
        font-weight:950 !important;
      }
      .bc-mark-arrived-v100-2-17,
      #arrivalQueue .bc-mark-arrived-v100-2-17 {
        min-width:132px !important;
        min-height:54px !important;
        padding:0 18px !important;
        border:2px solid #30bdd8 !important;
        border-radius:14px !important;
        background:#087694 !important;
        color:#fff !important;
        font-size:16px !important;
        font-weight:950 !important;
        opacity:1 !important;
      }
      .bc-mark-arrived-v100-2-17:hover { background:#075f77 !important; }
      .bc-ready-seat-source-v100-2-17 {
        display:inline-flex !important;
        align-items:center !important;
        margin-top:7px !important;
        padding:4px 8px !important;
        border-radius:999px !important;
        background:#dff4f0 !important;
        color:#124c54 !important;
        font-size:12px !important;
        font-weight:950 !important;
        text-transform:uppercase !important;
        letter-spacing:.06em !important;
      }
      .bc-special-priority-v100-2-17 {
        border-left:6px solid #f5be4f !important;
        background:#174f5c !important;
        box-shadow:0 0 0 2px rgba(245,190,79,.12) inset !important;
      }
      .bc-special-badge-v100-2-17 {
        display:inline-flex !important;
        align-items:center !important;
        width:max-content !important;
        margin-top:7px !important;
        padding:5px 9px !important;
        border-radius:999px !important;
        background:#fff0c7 !important;
        color:#5c3f00 !important;
        font-size:13px !important;
        font-weight:950 !important;
      }
      .bc-special-badge-v100-2-17::before { content:'★'; margin-right:5px; }
      .host-note-card {
        padding:18px !important;
        border:2px solid rgba(245,190,79,.34) !important;
        background:#103f4a !important;
      }
      .host-note-card .host-note-head span {
        color:#fff !important;
        font-size:17px !important;
        font-weight:950 !important;
      }
      .host-note-card > div:not(.host-note-head) { padding:10px 0 !important; }
      .host-note-card > div:not(.host-note-head) strong {
        color:#fff !important;
        font-size:16px !important;
        font-weight:950 !important;
      }
      .host-note-card > div:not(.host-note-head) p span {
        color:#b9d9dc !important;
        font-size:13px !important;
        font-weight:750 !important;
      }
      .host-note-card > div:not(.host-note-head) i { color:#f5be4f !important; font-size:20px !important; }
      .bc-ready-priority-label-v100-2-17 {
        margin:0 0 12px !important;
        color:#dff4f0 !important;
        font-size:13px !important;
        font-weight:900 !important;
        letter-spacing:.05em !important;
      }
      @media (max-width:900px) {
        .bc-mark-arrived-v100-2-17 { min-width:118px !important; }
        #arrivalQueue .queue-item.arrival strong, #waitlistQueue .queue-item strong { font-size:20px !important; }
      }
    `;
    document.head.appendChild(style);
  }

  const arrivalTab = [...document.querySelectorAll('.queue-tabs button')].find((b) => lower(b.dataset.queue || b.textContent).includes('arrival'));
  const waitlistTab = [...document.querySelectorAll('.queue-tabs button')].find((b) => lower(b.dataset.queue || b.textContent).includes('wait'));
  const badgeIn = (button) => button?.querySelector('span');
  const waitlistBadge = document.getElementById('waitlistBadge') || badgeIn(waitlistTab);
  const hostWaiting = document.getElementById('hostWaiting');

  const syncCounts = () => {
    const readyRows = [...waitlist.querySelectorAll('.queue-item')].filter((row) => !lower(row.textContent).includes('seated'));
    const expectedRows = [...arrivals.querySelectorAll('.queue-item.arrival')].filter((row) => getStatus(row).includes('expected'));
    if (waitlistBadge) waitlistBadge.textContent = String(readyRows.length);
    if (hostWaiting) hostWaiting.textContent = String(readyRows.length);
    const aBadge = badgeIn(arrivalTab);
    if (aBadge) aBadge.textContent = String(expectedRows.length);
  };

  const waitMinutes = (row) => Number(normalize(row.querySelector('.queue-time')?.textContent).match(/\d+/)?.[0] || 0);
  const priorityScore = (row) => {
    let score = 0;
    if (isSpecial(row)) score += 10000;
    if (row.dataset.bcSourceType === 'reservation') score += 1000;
    score += Math.min(999, waitMinutes(row));
    return score;
  };
  const sortReadyQueue = () => {
    const rows = [...waitlist.querySelectorAll('.queue-item')];
    rows.sort((a,b) => priorityScore(b)-priorityScore(a));
    rows.forEach((row) => waitlist.appendChild(row));
  };

  const decorateReadyRow = (row, sourceType='walk-in') => {
    row.dataset.bcSourceType = sourceType;
    const content = row.querySelector('div');
    if (content && !content.querySelector('.bc-ready-seat-source-v100-2-17')) {
      const source = document.createElement('span');
      source.className = 'bc-ready-seat-source-v100-2-17';
      source.textContent = sourceType === 'reservation' ? 'Reservation · Arrived' : 'Walk-in';
      content.appendChild(source);
    }
    const label = specialLabelFor(row.textContent);
    if (label && content && !content.querySelector('.bc-special-badge-v100-2-17')) {
      row.classList.add('bc-special-priority-v100-2-17');
      const badge = document.createElement('span');
      badge.className = 'bc-special-badge-v100-2-17';
      badge.textContent = label;
      content.appendChild(badge);
    }
  };

  const buildReadyRow = (sourceRow) => {
    const name = firstStrong(sourceRow);
    if (!name) return null;
    const detail = partyDetail(sourceRow) || 'Party of 2';
    const existing = [...waitlist.querySelectorAll('.queue-item')].find((row) => firstStrong(row) === name);
    if (existing) {
      decorateReadyRow(existing, 'reservation');
      return existing;
    }
    const row = document.createElement('article');
    row.className = 'queue-item bc-arrived-reservation-ready-v100-2-17';
    row.dataset.bcGuestStatus = 'waiting';
    row.dataset.bcSourceType = 'reservation';
    row.innerHTML = `<span class="queue-time">0m</span><div><strong></strong><small></small></div><button type="button">Seat</button>`;
    row.querySelector('strong').textContent = name;
    row.querySelector('small').textContent = detail;
    decorateReadyRow(row, 'reservation');
    waitlist.appendChild(row);
    return row;
  };

  const markMatchingReservationRowsArrived = (name) => {
    [...hostWorkspace.querySelectorAll('article, .bc-guest-result')].forEach((row) => {
      if (firstStrong(row) !== name) return;
      row.dataset.bcGuestStatus = 'arrived';
      const node = statusNode(row);
      if (node && !row.closest('#waitlistQueue')) {
        node.textContent = 'Arrived';
        node.classList?.remove('pending');
      }
      row.querySelectorAll('.bc-mark-arrived-v100-2-17, .bc-arrival-action-v100-2-13').forEach((button) => button.remove());
    });
  };

  const moveArrivalToReady = (row) => {
    const name = firstStrong(row);
    if (!name) return;
    const ready = buildReadyRow(row);
    markMatchingReservationRowsArrived(name);
    if (row.closest('#arrivalQueue')) row.remove();
    if (ready) ready.dataset.bcGuestStatus = 'waiting';
    sortReadyQueue();
    syncCounts();
    if (waitlistTab) {
      waitlistTab.classList.add('bc-has-ready-v100-2-17');
      waitlistTab.setAttribute('aria-label', `${waitlistBadge?.textContent || ''} guests ready to seat`);
    }
  };

  const ensureMarkArrivedButtons = () => {
    // Side-panel Arrivals queue.
    [...arrivals.querySelectorAll('.queue-item.arrival')].forEach((row) => {
      const status = getStatus(row);
      if (status.includes('seated')) return;
      if (status.includes('arrived')) {
        moveArrivalToReady(row);
        return;
      }
      if (!status.includes('expected')) return;
      if (row.querySelector('.bc-mark-arrived-v100-2-17')) return;
      const old = row.querySelector('.bc-arrival-action-v100-2-13');
      if (old) old.remove();
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'bc-mark-arrived-v100-2-17';
      button.textContent = 'Mark arrived';
      row.appendChild(button);
    });

    // Full Reservations workspace / newly-created reservation rows.
    [...hostWorkspace.querySelectorAll('article')].forEach((row) => {
      if (row.closest('#arrivalQueue') || row.closest('#waitlistQueue')) return;
      const name = firstStrong(row);
      if (!name || !/party\s+of\s+\d+/i.test(normalize(row.textContent))) return;
      const status = getStatus(row);
      if (!status.includes('expected')) return;
      if (row.querySelector('.bc-mark-arrived-v100-2-17')) return;
      const actions = row.querySelector('button')?.parentElement || row;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'bc-mark-arrived-v100-2-17';
      button.textContent = 'Mark arrived';
      actions.appendChild(button);
    });
  };

  const clearBlankGenericBanner = () => {
    const generic = document.getElementById('bcActivePartyBannerV100_2_16');
    if (!generic) return;
    const title = normalize(generic.querySelector('strong')?.textContent);
    const oldInstruction = document.getElementById('bcWaitlistSeatInstructionV100_2_15');
    const oldVisible = oldInstruction && !oldInstruction.hidden && getComputedStyle(oldInstruction).display !== 'none';
    generic.classList.toggle('bc-empty-banner-v100-2-17', !title || oldVisible);
    if (!title || oldVisible) generic.hidden = true;
  };

  const decorateExistingReadyRows = () => {
    [...waitlist.querySelectorAll('.queue-item')].forEach((row) => decorateReadyRow(row, row.dataset.bcSourceType || 'walk-in'));
    sortReadyQueue();
    syncCounts();
  };

  hostWorkspace.addEventListener('click', (event) => {
    const button = event.target.closest('.bc-mark-arrived-v100-2-17, .bc-arrival-action-v100-2-13');
    if (!button) return;
    const row = button.closest('article, .queue-item, .bc-guest-result');
    if (!row) return;
    const label = lower(button.textContent);
    if (!label.includes('mark arrived')) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    moveArrivalToReady(row);
    if (waitlistTab) waitlistTab.click();
  }, true);

  // Priority is operational, not decorative: make special occasions unmistakable wherever seen.
  document.querySelectorAll('.host-note-card').forEach((card) => card.setAttribute('aria-label','Special occasions and guest moments — priority context'));

  decorateExistingReadyRows();
  ensureMarkArrivedButtons();
  clearBlankGenericBanner();

  let scheduled = false;
  const observer = new MutationObserver(() => {
    if (scheduled) return;
    scheduled = true;
    queueMicrotask(() => {
      scheduled = false;
      ensureMarkArrivedButtons();
      decorateExistingReadyRows();
      clearBlankGenericBanner();
    });
  });
  observer.observe(hostWorkspace, {childList:true,subtree:true,characterData:true});

  document.addEventListener('click', () => queueMicrotask(clearBlankGenericBanner), true);
  window.__bcArrivalPriorityQueueV100_2_17 = { moveArrivalToReady, sortReadyQueue, syncCounts };
})();

const gs=document.getElementById('guestSearch');
if(gs){
 gs.addEventListener('input',()=>{
  const names=['Anthony Russo','Anthony Miller','Anthony Romano'];
  const q=gs.value.toLowerCase();
  document.getElementById('guestResults').innerHTML=
   names.filter(n=>n.toLowerCase().includes(q)).join('<br>');
 });
}


// V5.5 — Executive Command Center
const executiveRanges = {
  "Tonight": {
    guests: "1,026",
    reservations: "220",
    calls: "176",
    revenue: "$31.8K",
    summary: "Portfolio demand is strong and currently tracking above last Friday. Marina Grille is the only location approaching hard capacity, while Captain's Inn has additional room and may absorb overflow demand. Call coverage remains healthy across the group."
  },
  "7 Days": {
    guests: "6,942",
    reservations: "1,486",
    calls: "1,208",
    revenue: "$218K",
