+    const p=s.procedures||{};
+    $("pdpProcedures").innerHTML=Object.entries(p).map(([k,v])=>`<article><strong>${esc(k.replaceAll(/([A-Z])/g," $1"))}</strong>${Object.entries(v).map(([a,b])=>`<p><b>${esc(a)}</b> · ${esc(b)}</p>`).join("")}</article>`).join("");
+  }
