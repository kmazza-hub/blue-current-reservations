// V100.2.16 — Generic Guest Action Context + Host Stand Contrast Polish
(() => {
  const hostWorkspace = document.querySelector('.host-workspace');
  const floorPanel = document.querySelector('.host-floor-panel');
  const floorMap = document.getElementById('hostFloorMap');
  const waitlist = document.getElementById('waitlistQueue');
  const arrivals = document.getElementById('arrivalQueue');
  const detail = document.getElementById('hostTableDetail');
  const assignButton = document.getElementById('assignTableButton');
  const navButtons = [...document.querySelectorAll('.host-nav button')];
  if (!hostWorkspace || !floorPanel || !floorMap || !waitlist || !arrivals || !navButtons.length) return;

  const styleId = 'bc-generic-guest-context-v100-2-16';
  if (!document.getElementById(styleId)) {
    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = `
      /* Aim small, miss small: no pale controls, no mystery state, no demo-only guest context. */
      .bc-waitlist-seat-confirm-v100-2-15 {
        background:#ffffff !important;
        color:#102f39 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 small {
        color:#315d66 !important;
        font-size:14px !important;
        font-weight:950 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 strong {
        color:#102f39 !important;
        font-size:24px !important;
        font-weight:950 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 p {
        color:#355b63 !important;
        font-size:17px !important;
        font-weight:700 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 .bc-confirm-seat {
        background:#087694 !important;
        color:#fff !important;
        border:2px solid #075f77 !important;
        font-weight:950 !important;
      }
      .bc-waitlist-seat-confirm-v100-2-15 .bc-cancel-seat,
      .bc-waitlist-seat-instruction-v100-2-15 > button {
        background:#f7f1e7 !important;
        color:#102f39 !important;
        border:2px solid #9eb5b9 !important;
        font-size:16px !important;
        font-weight:950 !important;
        opacity:1 !important;
      }
      .bc-waitlist-seat-instruction-v100-2-15 > button:hover,
      .bc-waitlist-seat-confirm-v100-2-15 .bc-cancel-seat:hover {
        background:#fff !important;
        border-color:#5e858d !important;
      }
      #waitlistQueue .queue-item,
      #arrivalQueue .queue-item.arrival,
      .bc-guest-result,
      .bc-host-clickable-party-v100-2-16 {
        cursor:pointer !important;
      }
      #waitlistQueue .queue-item:focus-visible,
      #arrivalQueue .queue-item.arrival:focus-visible,
      .bc-guest-result:focus-visible,
      .bc-host-clickable-party-v100-2-16:focus-visible {
        outline:4px solid #65d3c4 !important;
        outline-offset:3px !important;
      }
      .bc-party-dialog-backdrop-v100-2-16 {
        position:fixed;
        inset:0;
        z-index:2500;
        display:grid;
        place-items:center;
        padding:24px;
        background:rgba(2,18,24,.72);
        backdrop-filter:blur(5px);
      }
      .bc-party-dialog-backdrop-v100-2-16[hidden] { display:none !important; }
      .bc-party-dialog-v100-2-16 {
        width:min(560px,100%);
        max-height:min(760px,92vh);
        overflow:auto;
        border:2px solid #79cabe;
        border-radius:22px;
        background:#fff;
        color:#102f39;
        box-shadow:0 30px 90px rgba(0,0,0,.38);
      }
      .bc-party-dialog-head-v100-2-16 {
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:16px;
        padding:22px 24px 18px;
        border-bottom:1px solid #d8e4e5;
      }
      .bc-party-dialog-head-v100-2-16 small {
        display:block;
        color:#087694;
        font-weight:950;
        text-transform:uppercase;
        letter-spacing:.12em;
      }
      .bc-party-dialog-head-v100-2-16 h3 {
        margin:5px 0 0;
        color:#102f39;
        font-size:28px;
        line-height:1.05;
      }
      .bc-party-dialog-close-v100-2-16 {
        width:48px;
        height:48px;
        flex:0 0 48px;
        border:2px solid #9eb5b9;
        border-radius:50%;
        background:#f7f1e7;
        color:#102f39;
        font-size:23px;
        font-weight:950;
      }
      .bc-party-dialog-body-v100-2-16 { padding:22px 24px 24px; }
      .bc-party-status-v100-2-16 {
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:12px;
        margin-bottom:18px;
        padding:14px 16px;
        border-radius:14px;
        background:#eaf4f1;
      }
      .bc-party-status-v100-2-16 strong { color:#102f39; font-size:17px; }
      .bc-party-status-v100-2-16 span {
        padding:7px 11px;
        border-radius:999px;
        background:#fff;
        color:#174b56;
        font-weight:950;
      }
      .bc-party-form-v100-2-16 { display:grid; gap:14px; }
      .bc-party-form-v100-2-16 label { display:grid; gap:6px; color:#315d66; font-size:14px; font-weight:900; }
      .bc-party-form-v100-2-16 input,
      .bc-party-form-v100-2-16 textarea {
        width:100%;
        border:2px solid #a8c4c8;
        border-radius:12px;
        background:#fff;
        color:#102f39;
        padding:12px 14px;
        font:inherit;
        font-size:17px;
        font-weight:750;
        outline:none;
      }
      .bc-party-form-v100-2-16 input:focus,
      .bc-party-form-v100-2-16 textarea:focus { border-color:#087694; box-shadow:0 0 0 3px rgba(8,118,148,.15); }
      .bc-party-form-v100-2-16 textarea { min-height:82px; resize:vertical; }
      .bc-party-actions-v100-2-16 { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:18px; }
      .bc-party-actions-v100-2-16 button {
        min-height:52px;
        border-radius:12px;
        border:2px solid #9eb5b9;
        background:#f7f1e7;
        color:#102f39;
        font-size:16px;
        font-weight:950;
      }
      .bc-party-actions-v100-2-16 .primary {
        grid-column:1 / -1;
        border-color:#087694;
        background:#087694;
        color:#fff;
      }
      .bc-party-actions-v100-2-16 .secondary-strong {
        border-color:#2d7888;
        background:#e6f2f3;
        color:#103945;
      }
      .bc-active-party-banner-v100-2-16 {
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:18px;
        margin:0 0 16px;
        padding:16px 18px;
        border:2px solid #65d3c4;
        border-radius:16px;
        background:#0d4550;
        color:#fff;
        box-shadow:0 10px 28px rgba(0,0,0,.18);
      }
      .bc-active-party-banner-v100-2-16 strong { display:block; font-size:21px; line-height:1.1; }
      .bc-active-party-banner-v100-2-16 span { display:block; margin-top:4px; color:#d5eeee; font-size:15px; }
      .bc-active-party-banner-v100-2-16 button {
        min-height:48px;
        padding:0 17px;
        border:2px solid #9eb5b9;
        border-radius:12px;
        background:#f7f1e7;
        color:#102f39;
        font-size:16px;
        font-weight:950;
      }
      .host-table.bc-active-party-choice-v100-2-16 {
        outline:5px solid rgba(101,211,196,.65) !important;
        outline-offset:5px !important;
        cursor:pointer !important;
        transform:scale(1.06);
      }
      .host-table.bc-active-party-unavailable-v100-2-16 { opacity:.38 !important; filter:saturate(.35) !important; }
      .bc-active-party-confirm-v100-2-16 {
        position:absolute;
        z-index:75;
        right:22px;
        top:22px;
        width:min(380px,calc(100% - 44px));
        padding:20px;
        border:2px solid #65cbbc;
        border-radius:18px;
        background:#fff;
        color:#102f39;
        box-shadow:0 24px 60px rgba(0,0,0,.28);
      }
      .bc-active-party-confirm-v100-2-16[hidden] { display:none !important; }
      .bc-active-party-confirm-v100-2-16 small { color:#315d66; font-weight:950; text-transform:uppercase; letter-spacing:.08em; }
      .bc-active-party-confirm-v100-2-16 strong { display:block; margin:7px 0 6px; color:#102f39; font-size:24px; line-height:1.1; }
      .bc-active-party-confirm-v100-2-16 p { margin:0 0 16px; color:#355b63; font-size:16px; font-weight:700; }
      .bc-active-party-confirm-v100-2-16 button { width:100%; min-height:52px; border-radius:12px; font-size:16px; font-weight:950; }
      .bc-active-party-confirm-v100-2-16 .bc-active-confirm-primary { border:2px solid #087694; background:#087694; color:#fff; }
      .bc-active-party-confirm-v100-2-16 .bc-active-confirm-cancel { margin-top:8px; border:2px solid #9eb5b9; background:#f7f1e7; color:#102f39; }
      .bc-neutral-table-detail-v100-2-16 { color:#102f39 !important; }
      .bc-neutral-table-detail-v100-2-16 p { color:#315d66 !important; font-weight:700 !important; }
    `;
    document.head.appendChild(style);
  }

  const normalize = (value) => String(value || '').trim();
  const normalizeStatus = (value) => {
    const text = normalize(value).toLowerCase();
    if (text.includes('seated')) return 'seated';
    if (text.includes('arrived')) return 'arrived';
    if (text.includes('expected')) return 'expected';
    if (text.includes('waiting') || text.includes('waitlist')) return 'waiting';
    return text || 'guest';
  };
  const navLabel = (button) => normalize(button?.textContent).replace(/[^a-zA-Z]/g,'').toLowerCase();
  const floorNav = navButtons.find((button) => navLabel(button) === 'floor');
  const tables = () => [...document.querySelectorAll('.host-table')];
  const tableNumber = (table) => normalize(table?.dataset?.table);
  const tableState = (table) => ['available','reserved','seated','cleaning'].find((state) => table?.classList.contains(state)) || 'selected';
  const numberValue = (selector) => Number(document.querySelector(selector)?.textContent || 0);
  const setNumber = (selector, value) => { const node=document.querySelector(selector); if(node) node.textContent=String(Math.max(0,value)); };

  const state = window.__bcGenericGuestContextV100_2_16 || {
    activeParty:null,
    mode:null,
    selectedTable:null,
    returnFocus:null
  };
  window.__bcGenericGuestContextV100_2_16 = state;

  let dialogBackdrop = document.getElementById('bcPartyDialogBackdropV100_2_16');
  if (!dialogBackdrop) {
    dialogBackdrop = document.createElement('div');
    dialogBackdrop.id = 'bcPartyDialogBackdropV100_2_16';
    dialogBackdrop.className = 'bc-party-dialog-backdrop-v100-2-16';
    dialogBackdrop.hidden = true;
    dialogBackdrop.innerHTML = `
      <section class="bc-party-dialog-v100-2-16" role="dialog" aria-modal="true" aria-labelledby="bcPartyDialogTitleV100_2_16">
        <div class="bc-party-dialog-head-v100-2-16">
          <div><small id="bcPartyDialogKickerV100_2_16">Guest</small><h3 id="bcPartyDialogTitleV100_2_16">Guest details</h3></div>
          <button class="bc-party-dialog-close-v100-2-16" type="button" aria-label="Close guest details">×</button>
        </div>
        <div class="bc-party-dialog-body-v100-2-16">
          <div class="bc-party-status-v100-2-16"><strong id="bcPartyDialogSummaryV100_2_16"></strong><span id="bcPartyDialogStatusV100_2_16"></span></div>
          <div class="bc-party-form-v100-2-16">
            <label>Guest name<input id="bcPartyNameV100_2_16" type="text" autocomplete="off"></label>
            <label>Party size<input id="bcPartySizeV100_2_16" type="number" min="1" max="40" inputmode="numeric"></label>
            <label>Notes / preference<textarea id="bcPartyDetailV100_2_16"></textarea></label>
          </div>
          <div class="bc-party-actions-v100-2-16">
            <button id="bcPartySaveV100_2_16" type="button" class="secondary-strong">Save changes</button>
            <button id="bcPartySecondaryV100_2_16" type="button">Close</button>
            <button id="bcPartyPrimaryV100_2_16" type="button" class="primary">Done</button>
          </div>
        </div>
      </section>`;
    document.body.appendChild(dialogBackdrop);
  }

  let activeBanner = document.getElementById('bcActivePartyBannerV100_2_16');
  if (!activeBanner) {
    activeBanner = document.createElement('div');
    activeBanner.id = 'bcActivePartyBannerV100_2_16';
    activeBanner.className = 'bc-active-party-banner-v100-2-16';
    activeBanner.hidden = true;
    activeBanner.innerHTML = '<div><strong></strong><span></span></div><button type="button">Cancel</button>';
    floorPanel.insertBefore(activeBanner, floorPanel.firstChild);
  }

  let activeConfirm = document.getElementById('bcActivePartyConfirmV100_2_16');
  if (!activeConfirm) {
    activeConfirm = document.createElement('div');
    activeConfirm.id = 'bcActivePartyConfirmV100_2_16';
    activeConfirm.className = 'bc-active-party-confirm-v100-2-16';
    activeConfirm.hidden = true;
    activeConfirm.innerHTML = '<small>Confirm</small><strong></strong><p></p><button class="bc-active-confirm-primary" type="button">Confirm</button><button class="bc-active-confirm-cancel" type="button">Cancel</button>';
    floorMap.appendChild(activeConfirm);
  }

  const dialog = {
    kicker: document.getElementById('bcPartyDialogKickerV100_2_16'),
    title: document.getElementById('bcPartyDialogTitleV100_2_16'),
    summary: document.getElementById('bcPartyDialogSummaryV100_2_16'),
    status: document.getElementById('bcPartyDialogStatusV100_2_16'),
    name: document.getElementById('bcPartyNameV100_2_16'),
    size: document.getElementById('bcPartySizeV100_2_16'),
    detail: document.getElementById('bcPartyDetailV100_2_16'),
    save: document.getElementById('bcPartySaveV100_2_16'),
    secondary: document.getElementById('bcPartySecondaryV100_2_16'),
    primary: document.getElementById('bcPartyPrimaryV100_2_16'),
    close: dialogBackdrop.querySelector('.bc-party-dialog-close-v100-2-16')
  };

  const parsePartySize = (text) => Number(normalize(text).match(/party\s+of\s+(\d+)/i)?.[1] || 2);
  const replacePartySize = (text, size) => {
    const source = normalize(text) || `Party of ${size}`;
    return /party\s+of\s+\d+/i.test(source) ? source.replace(/party\s+of\s+\d+/i, `Party of ${size}`) : `Party of ${size}${source ? ` · ${source}` : ''}`;
  };

  const statusNodeFor = (row) => {
    if (!row) return null;
    const direct = row.querySelector('.arrival-chip, em, [data-bc-status], .status-chip, .guest-status');
    if (direct) return direct;
    return [...row.querySelectorAll('span,button')].find((node) => /^(expected|arrived|waiting|seated(?:\s*·.*)?)$/i.test(normalize(node.textContent))) || null;
  };

  const rowsForName = (name) => [...document.querySelectorAll('.host-workspace article, .bc-guest-result')].filter((row) => {
    const strong = row.querySelector('strong');
    return normalize(strong?.textContent) === name;
  });

  const sourceTypeFor = (row) => {
    if (!row) return 'guest';
    if (row.closest('#waitlistQueue')) return 'waitlist';
    if (row.closest('#arrivalQueue')) return 'reservation';
    if (row.classList.contains('bc-guest-result')) return 'guest';
    const text = normalize(row.textContent).toLowerCase();
    if (text.includes('expected') || text.includes('arrived') || text.includes('reservation')) return 'reservation';
    if (text.includes('waiting') || text.includes('waitlist')) return 'waitlist';
    return 'guest';
  };

  const partyFromRow = (row) => {
    const name = normalize(row?.querySelector('strong')?.textContent);
    if (!name) return null;
    const detailNode = row.querySelector('small') || [...row.querySelectorAll('span')].find((node) => /party\s+of\s+\d+/i.test(normalize(node.textContent)));
    const detailText = normalize(detailNode?.textContent) || 'Party of 2';
    const statusText = normalize(statusNodeFor(row)?.textContent) || (row.closest('#waitlistQueue') ? 'Waiting' : 'Guest');
    const tableFromStatus = statusText.match(/table\s+(\d+)/i)?.[1] || row.dataset.bcTable || '';
    return {
      name,
      originalName:name,
      partySize:parsePartySize(detailText),
      detail:detailText,
      status:normalizeStatus(statusText),
      statusText,
      tableNumber:tableFromStatus,
      sourceType:sourceTypeFor(row),
      sourceRow:row
    };
  };

  const findBestRow = (name, preferredType) => {
    const rows = rowsForName(name);
    return rows.find((row) => sourceTypeFor(row) === preferredType) || rows[0] || null;
  };

  const refreshGuestSearch = () => {
    const input = document.getElementById('bcHostGuestSearchV100_2_14');
    if (input) input.dispatchEvent(new Event('input', {bubbles:true}));
  };

  const updateStatusEverywhere = (name, status, tableNumberValue='') => {
    rowsForName(name).forEach((row) => {
      row.dataset.bcGuestStatus = status;
      if (tableNumberValue) row.dataset.bcTable = tableNumberValue;
      else if (status !== 'seated') row.removeAttribute('data-bc-table');
      const node = statusNodeFor(row);
      if (node) {
        node.textContent = status === 'seated' ? `Seated · Table ${tableNumberValue}` : status.charAt(0).toUpperCase()+status.slice(1);
        if (node.classList.contains('arrival-chip')) {
          node.classList.toggle('pending', status === 'expected');
          node.classList.toggle('bc-seated-table', status === 'seated');
        }
      }
      const markAction = row.querySelector('.bc-arrival-action-v100-2-13');
      if (markAction) markAction.hidden = status !== 'expected';
    });
    refreshGuestSearch();
  };

  const updatePartyEverywhere = (oldName, newName, partySizeValue, detailText) => {
    const rows = rowsForName(oldName);
    rows.forEach((row) => {
      const strong = row.querySelector('strong');
      if (strong) strong.textContent = newName;
      const detailNode = row.querySelector('small') || [...row.querySelectorAll('span')].find((node) => /party\s+of\s+\d+/i.test(normalize(node.textContent)));
      if (detailNode) detailNode.textContent = replacePartySize(detailText, partySizeValue);
    });
    tables().forEach((table) => { if (table.dataset.bcGuestName === oldName) table.dataset.bcGuestName = newName; });
    refreshGuestSearch();
  };

  const closeDialog = () => {
    dialogBackdrop.hidden = true;
    state.activeParty = null;
    if (state.returnFocus && document.contains(state.returnFocus)) state.returnFocus.focus?.();
    state.returnFocus = null;
  };

  const renderDialogActions = () => {
    const party = state.activeParty;
    if (!party) return;
    const status = normalizeStatus(party.status);
    dialog.kicker.textContent = party.sourceType === 'waitlist' ? 'Waitlist' : party.sourceType === 'reservation' ? 'Reservation' : 'Guest';
    dialog.title.textContent = party.name;
    dialog.summary.textContent = `Party of ${party.partySize}${party.tableNumber ? ` · Table ${party.tableNumber}` : ''}`;
    dialog.status.textContent = status.charAt(0).toUpperCase()+status.slice(1);
    dialog.name.value = party.name;
    dialog.size.value = String(party.partySize || 2);
    dialog.detail.value = party.detail || `Party of ${party.partySize || 2}`;

    dialog.primary.hidden = false;
    dialog.secondary.hidden = false;
    dialog.secondary.textContent = 'Close';
    dialog.secondary.classList.remove('secondary-strong');

    if (status === 'waiting') {
      dialog.primary.textContent = 'Seat guest';
    } else if (status === 'expected') {
      dialog.primary.textContent = 'Mark arrived';
      dialog.secondary.textContent = 'Reserve a table';
      dialog.secondary.classList.add('secondary-strong');
    } else if (status === 'arrived') {
      dialog.primary.textContent = 'Seat guest';
    } else if (status === 'seated') {
      dialog.primary.textContent = party.tableNumber ? `Open Table ${party.tableNumber}` : 'Done';
    } else {
      dialog.primary.textContent = 'Done';
    }
  };

  const openPartyDialog = (row) => {
    const party = partyFromRow(row);
    if (!party) return;
    state.activeParty = party;
    state.returnFocus = document.activeElement;
    renderDialogActions();
    dialogBackdrop.hidden = false;
    dialog.name.focus();
  };

  const clearTableChoiceStyles = () => {
    tables().forEach((table) => table.classList.remove('bc-active-party-choice-v100-2-16','bc-active-party-unavailable-v100-2-16','selected'));
  };

  const cancelActivePartyFlow = () => {
    state.mode = null;
    state.selectedTable = null;
    state.activeParty = null;
    activeBanner.hidden = true;
    activeConfirm.hidden = true;
    clearTableChoiceStyles();
  };

  const canUseTable = (table, party) => {
    const status = tableState(table);
    if (status === 'available' || status === 'cleaning') return true;
    if (status === 'reserved' && normalize(table.dataset.bcGuestName) === party.name) return true;
    return false;
  };

  const beginTableChoice = (party, mode) => {
    state.activeParty = {...party};
    state.mode = mode;
    state.selectedTable = null;
    dialogBackdrop.hidden = true;
    if (floorNav) floorNav.click();
    // V100.2.15 has its own waitlist banner. Hide it while V100.2.16 owns the task.
    const oldBanner = document.getElementById('bcWaitlistSeatInstructionV100_2_15');
    const oldConfirm = document.getElementById('bcWaitlistSeatConfirmV100_2_15');
    if (oldBanner) oldBanner.hidden = true;
    if (oldConfirm) oldConfirm.hidden = true;
    if (detail) { detail.hidden = true; detail.setAttribute('aria-hidden','true'); detail.classList.remove('bc-detail-open'); }
    if (assignButton) { assignButton.hidden = true; assignButton.disabled = true; }
    activeBanner.querySelector('strong').textContent = mode === 'reserve' ? `Choose a table to hold for ${party.name}` : `Choose a table for ${party.name}`;
    activeBanner.querySelector('span').textContent = `Party of ${party.partySize} · Tap one highlighted table.`;
    activeBanner.hidden = false;
    activeConfirm.hidden = true;
    tables().forEach((table) => {
      const usable = canUseTable(table, party);
      table.classList.toggle('bc-active-party-choice-v100-2-16', usable);
      table.classList.toggle('bc-active-party-unavailable-v100-2-16', !usable);
    });
  };

  const chooseActiveTable = (table) => {
    const party = state.activeParty;
    if (!party || !state.mode || !canUseTable(table, party)) return;
    state.selectedTable = table;
    tables().forEach((item) => item.classList.toggle('selected', item === table));
    const number = tableNumber(table);
    const verb = state.mode === 'reserve' ? 'Reserve' : 'Seat';
    activeConfirm.querySelector('strong').textContent = `${verb} ${party.name} at Table ${number}`;
    activeConfirm.querySelector('p').textContent = `Party of ${party.partySize} · Table ${number} is ${tableState(table)}.`;
    activeConfirm.querySelector('.bc-active-confirm-primary').textContent = `${verb} ${party.name.split(' ')[0]} at Table ${number}`;
    activeConfirm.hidden = false;
  };

  const showToast = (message) => {
    const toast = document.createElement('div');
    toast.className = 'bc-host-seat-toast-v100-2-15';
    toast.setAttribute('role','status');
    toast.textContent = message;
    floorPanel.appendChild(toast);
    setTimeout(() => toast.remove(), 2200);
  };

  const completeActivePartyTableAction = () => {
    const party = state.activeParty;
    const table = state.selectedTable;
    const mode = state.mode;
    if (!party || !table || !mode) return;
    const number = tableNumber(table);
    const prior = tableState(table);

    if (mode === 'reserve') {
      if (prior === 'available') { setNumber('#availableCount', numberValue('#availableCount')-1); setNumber('#hostOpen', numberValue('#hostOpen')-1); }
      if (prior === 'cleaning') setNumber('#cleaningCount', numberValue('#cleaningCount')-1);
      if (prior !== 'reserved') setNumber('#reservedCount', numberValue('#reservedCount')+1);
      table.classList.remove('available','cleaning','seated');
      table.classList.add('reserved');
      table.dataset.bcGuestName = party.name;
      table.dataset.bcGuestStatus = 'assigned';
      table.dataset.bcPriorTableState = prior;
      const small = table.querySelector('small');
      if (small) small.textContent = 'Held';
      rowsForName(party.name).forEach((row) => row.dataset.bcHeldTable = number);
      const recommendation = document.getElementById('hostRecommendation');
      if (recommendation) recommendation.textContent = `Table ${number} held for ${party.name}`;
      cancelActivePartyFlow();
      showToast(`Table ${number} held for ${party.name}`);
      return;
    }

    if (prior === 'available') { setNumber('#availableCount', numberValue('#availableCount')-1); setNumber('#hostOpen', numberValue('#hostOpen')-1); }
    if (prior === 'cleaning') setNumber('#cleaningCount', numberValue('#cleaningCount')-1);
    if (prior === 'reserved') setNumber('#reservedCount', numberValue('#reservedCount')-1);
    setNumber('#seatedCount', numberValue('#seatedCount')+1);
    setNumber('#hostSeated', numberValue('#hostSeated')+1);

    table.classList.remove('available','cleaning','reserved');
    table.classList.add('seated');
    table.dataset.bcGuestName = party.name;
    table.dataset.bcGuestStatus = 'seated';
    table.dataset.bcTable = number;
    const small = table.querySelector('small');
    if (small) small.textContent = 'Seated';
    updateStatusEverywhere(party.name, 'seated', number);
    const recommendation = document.getElementById('hostRecommendation');
    if (recommendation) recommendation.textContent = `${party.name} seated at Table ${number}`;
    cancelActivePartyFlow();
    showToast(`${party.name} seated at Table ${number}`);
  };

  const showNeutralTableDetail = (table) => {
    if (!detail) return;
    const number = tableNumber(table);
    const status = tableState(table);
    const guest = normalize(table.dataset.bcGuestName);
    tables().forEach((item) => item.classList.toggle('selected', item === table));
    const headStrong = detail.querySelector('.host-table-detail-head strong') || detail.querySelector('strong');
    if (headStrong) headStrong.textContent = `Table ${number}`;
    const chip = detail.querySelector('.cleaning-chip');
    if (chip) chip.textContent = status.charAt(0).toUpperCase()+status.slice(1);
    const grid = detail.querySelector('.host-table-detail-grid');
    if (grid) {
      const cells = [...grid.querySelectorAll('div')];
      if (cells[0]) { cells[0].querySelector('span') && (cells[0].querySelector('span').textContent='Seats'); }
      if (cells[1]) { cells[1].querySelector('span') && (cells[1].querySelector('span').textContent='Status'); cells[1].querySelector('strong') && (cells[1].querySelector('strong').textContent=status); }
      if (cells[2]) { cells[2].querySelector('span') && (cells[2].querySelector('span').textContent='Current guest'); cells[2].querySelector('strong') && (cells[2].querySelector('strong').textContent=guest || '—'); }
    }
    const paragraph = detail.querySelector('p');
    if (paragraph) paragraph.textContent = guest ? `${guest} is attached to Table ${number}.` : `Table ${number} is ${status}. Select a guest first to reserve or seat.`;
    detail.classList.add('bc-neutral-table-detail-v100-2-16','bc-detail-open');
    detail.hidden = false;
    detail.removeAttribute('aria-hidden');
    if (assignButton) { assignButton.hidden = true; assignButton.disabled = true; }
  };

  const savePartyChanges = () => {
    const party = state.activeParty;
    if (!party) return;
    const oldName = party.name;
    const newName = normalize(dialog.name.value) || oldName;
    const newSize = Math.max(1, Number(dialog.size.value || party.partySize || 2));
    const newDetail = normalize(dialog.detail.value) || `Party of ${newSize}`;
    updatePartyEverywhere(oldName, newName, newSize, newDetail);
    party.name = newName;
    party.partySize = newSize;
    party.detail = replacePartySize(newDetail, newSize);
    party.originalName = newName;
    renderDialogActions();
    showToast(`${newName} updated`);
  };

  dialog.save.addEventListener('click', savePartyChanges);
  dialog.close.addEventListener('click', closeDialog);
  dialogBackdrop.addEventListener('click', (event) => { if (event.target === dialogBackdrop) closeDialog(); });

  dialog.secondary.addEventListener('click', () => {
    const party = state.activeParty;
    if (!party) return closeDialog();
    if (normalizeStatus(party.status) === 'expected' && dialog.secondary.textContent.toLowerCase().includes('reserve')) {
      beginTableChoice(party, 'reserve');
    } else closeDialog();
  });

  dialog.primary.addEventListener('click', () => {
    const party = state.activeParty;
    if (!party) return;
    const status = normalizeStatus(party.status);

    if (status === 'waiting') {
      const liveRow = findBestRow(party.name, 'waitlist');
      closeDialog();
      const seatButton = liveRow ? [...liveRow.querySelectorAll('button')].find((button) => normalize(button.textContent).toLowerCase() === 'seat') : null;
      if (seatButton) seatButton.click();
      return;
    }

    if (status === 'expected') {
      party.status = 'arrived';
      party.statusText = 'Arrived';
      updateStatusEverywhere(party.name, 'arrived');
      renderDialogActions();
      return;
    }

    if (status === 'arrived') {
      beginTableChoice(party, 'seat');
      return;
    }

    if (status === 'seated' && party.tableNumber) {
      const table = tables().find((item) => tableNumber(item) === String(party.tableNumber));
      closeDialog();
      if (floorNav) floorNav.click();
      if (table) showNeutralTableDetail(table);
      return;
    }

    closeDialog();
  });

  activeBanner.querySelector('button').addEventListener('click', cancelActivePartyFlow);
  activeConfirm.querySelector('.bc-active-confirm-cancel').addEventListener('click', cancelActivePartyFlow);
  activeConfirm.querySelector('.bc-active-confirm-primary').addEventListener('click', completeActivePartyTableAction);

  // Make guest-like rows discoverable and operable without tiny target hunting.
  const markClickableRows = () => {
    [...hostWorkspace.querySelectorAll('article, .bc-guest-result')].forEach((row) => {
      const strong = row.querySelector('strong');
      if (!strong || !/party\s+of\s+\d+/i.test(normalize(row.textContent))) return;
      row.classList.add('bc-host-clickable-party-v100-2-16');
      if (!row.hasAttribute('tabindex')) row.tabIndex = 0;
    });
  };
  markClickableRows();
  const observer = new MutationObserver(markClickableRows);
  observer.observe(hostWorkspace, {childList:true,subtree:true});

  // Generic row/details opening. Preserve dedicated Seat buttons and other primary actions.
  hostWorkspace.addEventListener('click', (event) => {
    const row = event.target.closest('article, .bc-guest-result');
    if (!row || !hostWorkspace.contains(row) || !/party\s+of\s+\d+/i.test(normalize(row.textContent))) return;
    const button = event.target.closest('button');
    if (button) {
      const label = normalize(button.textContent).toLowerCase();
      if (label === 'seat' || label.includes('mark arrived')) return;
      if (!(label.includes('detail') || label.includes('view'))) return;
      event.preventDefault();
      event.stopImmediatePropagation();
    }
    openPartyDialog(row);
  }, true);

  hostWorkspace.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const row = event.target.closest('.bc-host-clickable-party-v100-2-16');
    if (!row || event.target.closest('button,input,textarea')) return;
    event.preventDefault();
    openPartyDialog(row);
  });

  // Floor tables are neutral unless a guest workflow explicitly owns them.
  // Capture prevents the older Anthony-specific demo handler from leaking into generic operation.
  floorMap.addEventListener('click', (event) => {
    const table = event.target.closest('.host-table');
    if (!table) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    if (state.activeParty && state.mode) chooseActiveTable(table);
    else showNeutralTableDetail(table);
  }, true);

  // Keep V100.2.15 waitlist flow intact. When its guided flow begins, V100.2.16 does not compete.
  waitlist.addEventListener('click', (event) => {
    const seat = event.target.closest('button');
    const row = seat?.closest('.queue-item');
    if (!seat || !row || normalize(seat.textContent).toLowerCase() !== 'seat') return;
    state.activeParty = null;
    state.mode = null;
    activeBanner.hidden = true;
    activeConfirm.hidden = true;
  }, true);

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!dialogBackdrop.hidden) closeDialog();
    else if (state.mode) cancelActivePartyFlow();
  });
})();
