/* V100.2.26 — Dynamic Wait Quote + Functional Reserved Table Tools */
.bc-host-current-wait-quote-v100-2-26{display:flex;align-items:center;gap:10px;margin:10px 0 12px;padding:10px 14px;border:1px solid rgba(113,214,201,.34);border-radius:14px;background:#0b3039;color:#fff}.bc-host-current-wait-quote-v100-2-26 small{font-size:11px;font-weight:900;letter-spacing:.08em;color:#91cbd1}.bc-host-current-wait-quote-v100-2-26 strong{font-size:18px;font-weight:950;color:#fff}.bc-host-current-wait-quote-v100-2-26 span{font-size:12px;font-weight:700;color:#a8cbd0;margin-left:auto}.bc-reserved-table-tool-v100-2-26{position:absolute;z-index:48;left:50%;top:50%;transform:translate(-50%,-50%);width:min(430px,calc(100% - 28px));padding:20px;border:2px solid #d7aa48;border-radius:20px;background:#fff;color:#0e3039;box-shadow:0 22px 60px rgba(0,0,0,.25)}.bc-reserved-table-tool-v100-2-26[hidden]{display:none!important}.bc-reserved-table-tool-v100-2-26 header{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding-bottom:14px;border-bottom:1px solid #dbe4e4}.bc-reserved-table-tool-v100-2-26 header small{display:block;color:#8b691f;font-size:12px;font-weight:950;letter-spacing:.08em}.bc-reserved-table-tool-v100-2-26 header strong{display:block;color:#102f39;font-size:26px;line-height:1.05;font-weight:950}.bc-reserved-time-v100-2-26{display:block;margin-top:4px;color:#526c72;font-size:15px;font-weight:800}.bc-reserved-close-v100-2-26{width:44px;height:44px;border:1px solid #b9c7c8;border-radius:50%;background:#f5f7f6;color:#102f39;font-size:26px;font-weight:900}.bc-reserved-linked-v100-2-26{margin:14px 0;padding:14px;border-radius:14px;background:#eef7f5}.bc-reserved-linked-v100-2-26 strong{display:block;color:#102f39;font-size:20px;font-weight:950}.bc-reserved-linked-v100-2-26 span{display:block;margin-top:3px;color:#49656c;font-size:14px;font-weight:750}.bc-reserved-guest-label-v100-2-26{display:block;color:#2a4a53;font-size:13px;font-weight:900}.bc-reserved-guest-select-v100-2-26{display:block;width:100%;min-height:50px;margin-top:6px;padding:0 12px;border:2px solid #9cb8bb;border-radius:12px;background:#fff;color:#102f39;font-size:16px;font-weight:800}.bc-reserved-primary-v100-2-26,.bc-reserved-release-v100-2-26{width:100%;min-height:54px;margin-top:12px;border-radius:13px;font-size:17px;font-weight:950}.bc-reserved-primary-v100-2-26{border:0;background:#087b97;color:#fff}.bc-reserved-primary-v100-2-26:disabled{background:#d9e2e2;color:#718488}.bc-reserved-release-v100-2-26{border:2px solid #c9a35a;background:#fff8ea;color:#6a4a0d}.host-table.bc-reserved-tool-selected-v100-2-26{outline:5px solid rgba(215,170,72,.52)!important;outline-offset:5px!important}@media(max-width:900px){.bc-host-current-wait-quote-v100-2-26{flex-wrap:wrap}.bc-host-current-wait-quote-v100-2-26 span{width:100%;margin-left:0}}
