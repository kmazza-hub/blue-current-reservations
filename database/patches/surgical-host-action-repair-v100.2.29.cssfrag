/* V100.2.29 — Surgical Host Action Repair
   Repair V100.2.28 without touching host workflow logic.
   Scope every visual rule to the exact component it owns. */

/* 1) Restore the unified seating confirmation CARD itself.
   V100.2.28 accidentally styled this container as if it were a primary button. */
#host-stand .bc-unified-seat-confirm-v100-2-18 {
  position:absolute !important;
  z-index:40 !important;
  left:50% !important;
  top:50% !important;
  transform:translate(-50%,-50%) !important;
  display:block !important;
  width:min(430px,calc(100% - 32px)) !important;
  min-height:0 !important;
  padding:24px !important;
  border:2px solid #72d5c9 !important;
  border-radius:20px !important;
  background:#ffffff !important;
  color:#12333c !important;
  -webkit-text-fill-color:initial !important;
  text-align:left !important;
  box-shadow:0 20px 52px rgba(0,0,0,.24) !important;
  white-space:normal !important;
  opacity:1 !important;
}
#host-stand .bc-unified-seat-confirm-v100-2-18[hidden] { display:none !important; }
#host-stand .bc-unified-seat-confirm-v100-2-18 small {
  display:block !important;
  color:#315e67 !important;
  -webkit-text-fill-color:#315e67 !important;
  font-size:13px !important;
  line-height:1.1 !important;
  font-weight:950 !important;
  letter-spacing:.08em !important;
  text-transform:uppercase !important;
}
#host-stand .bc-unified-seat-confirm-v100-2-18 strong {
  display:block !important;
  margin:7px 0 6px !important;
  color:#102f39 !important;
  -webkit-text-fill-color:#102f39 !important;
  font-size:26px !important;
  line-height:1.15 !important;
  font-weight:950 !important;
}
#host-stand .bc-unified-seat-confirm-v100-2-18 p {
  display:block !important;
  margin:0 0 18px !important;
  color:#375861 !important;
  -webkit-text-fill-color:#375861 !important;
  font-size:17px !important;
  line-height:1.35 !important;
  font-weight:800 !important;
}

/* Actual confirm action: strong, centered, obvious. */
#host-stand .bc-unified-seat-confirm-v100-2-18 .bc-unified-confirm-v100-2-18 {
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  width:100% !important;
  min-width:0 !important;
  min-height:58px !important;
  padding:12px 18px !important;
  box-sizing:border-box !important;
  border:2px solid #31c6e4 !important;
  border-radius:14px !important;
  background:#087d99 !important;
  color:#ffffff !important;
  -webkit-text-fill-color:#ffffff !important;
  opacity:1 !important;
  font-size:18px !important;
  line-height:1.1 !important;
  font-weight:950 !important;
  text-align:center !important;
  white-space:normal !important;
}

/* Cancel is secondary but must remain readable. Applies to both chooser and confirm card. */
#host-stand .bc-unified-cancel-v100-2-18 {
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  min-width:124px !important;
  min-height:56px !important;
  padding:0 20px !important;
  box-sizing:border-box !important;
  border:2px solid #b7c8c8 !important;
  border-radius:14px !important;
  background:#fff8ec !important;
  color:#15333b !important;
  -webkit-text-fill-color:#15333b !important;
  opacity:1 !important;
  font-size:18px !important;
  line-height:1.1 !important;
  font-weight:950 !important;
  text-align:center !important;
}
#host-stand .bc-unified-seat-confirm-v100-2-18 .bc-unified-cancel-v100-2-18 {
  width:100% !important;
  margin-top:10px !important;
}

/* 2) Restore queue action buttons to the compact service-funnel geometry.
   Do not let a button consume the information column or clip outside the rail. */
#host-stand #waitlistQueue .queue-item > button,
#host-stand #arrivalQueue .queue-item.arrival > button,
#host-stand .bc-mark-arrived-v100-2-17 {
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  justify-self:stretch !important;
  width:100% !important;
  min-width:0 !important;
  max-width:92px !important;
  min-height:44px !important;
  padding:0 10px !important;
  box-sizing:border-box !important;
  border:2px solid #31c6e4 !important;
  border-radius:12px !important;
  background:#087d99 !important;
  color:#ffffff !important;
  -webkit-text-fill-color:#ffffff !important;
  opacity:1 !important;
  font-size:.88rem !important;
  line-height:1.05 !important;
  font-weight:950 !important;
  text-align:center !important;
  white-space:nowrap !important;
  overflow:hidden !important;
}
#host-stand #waitlistQueue .queue-item > button:hover,
#host-stand #arrivalQueue .queue-item.arrival > button:hover,
#host-stand .bc-mark-arrived-v100-2-17:hover {
  background:#066d86 !important;
}

/* Disabled queue actions remain legible without looking active. */
#host-stand #waitlistQueue .queue-item > button:disabled,
#host-stand #arrivalQueue .queue-item.arrival > button:disabled,
#host-stand .bc-mark-arrived-v100-2-17:disabled {
  background:#dce6e5 !important;
  border-color:#b8c9c8 !important;
  color:#486269 !important;
  -webkit-text-fill-color:#486269 !important;
  opacity:1 !important;
}

/* Protect the three-column queue contract introduced in V100.2.24/27. */
#host-stand #waitlistQueue .queue-item {
  grid-template-columns:46px minmax(118px,1fr) 92px !important;
  overflow:hidden !important;
}
#host-stand #waitlistQueue .queue-item > div {
  min-width:0 !important;
  max-width:100% !important;
}
#host-stand #waitlistQueue .bc-ready-priority-v100-2-17,
#host-stand #waitlistQueue .bc-special-badge-v100-2-17 {
  max-width:100% !important;
}

/* 3) Reserved-table card gets readability fixes only within its own component. */
#host-stand .bc-reserved-table-tool-v100-2-26 {
  background:#ffffff !important;
  color:#0b2f39 !important;
}
#host-stand .bc-reserved-table-tool-v100-2-26 header small,
#host-stand .bc-reserved-guest-label-v100-2-26,
#host-stand .bc-reserved-linked-v100-2-26 strong,
#host-stand .bc-reserved-linked-v100-2-26 span,
#host-stand .bc-reserved-time-v100-2-26 {
  opacity:1 !important;
}
#host-stand .bc-reserved-linked-v100-2-26 strong,
#host-stand .bc-reserved-linked-v100-2-26 span,
#host-stand .bc-reserved-time-v100-2-26 {
  color:#0b2f39 !important;
  -webkit-text-fill-color:#0b2f39 !important;
}
#host-stand .bc-reserved-table-tool-v100-2-26 header small,
#host-stand .bc-reserved-guest-label-v100-2-26 {
  color:#345760 !important;
  -webkit-text-fill-color:#345760 !important;
}

@media (max-width:1100px) {
  #host-stand #waitlistQueue .queue-item {
    grid-template-columns:42px minmax(108px,1fr) 84px !important;
    gap:10px !important;
  }
  #host-stand #waitlistQueue .queue-item > button,
  #host-stand #arrivalQueue .queue-item.arrival > button,
  #host-stand .bc-mark-arrived-v100-2-17 {
    max-width:84px !important;
    padding-inline:8px !important;
    font-size:.84rem !important;
  }
}
