+ async function load(){try{const x=await e.load(),rows=x.items||[];renderRun(rows[0]);$('aparCount').textContent=x.count||0;$('aparList').innerHTML=rows.slice(0,20).map(r=>`<article><div><strong>${esc(r.agentType)} · ${esc(r.status)}</strong><span>${esc(r.id)} · ${esc(r.intent)} · ${r.stepCount||0} steps · ${r.approvalRequired?'approval-gated':'dry-run ready'}</span></div><button type="button" data-run-id="${esc(r.id)}">Inspect</button></article>`).join('')||'<p>No persistent AIP agent runs yet.</p>';}catch(err){$('aparCurrent').textContent=err.message;}}
+ async function create(){try{const x=await e.create($('aparAgentType')?.value||'operations-optimizer');renderRun(x.run);await load();}catch(err){$('aparCurrent').textContent=err.message;}}
