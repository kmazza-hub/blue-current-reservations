+(function(global){"use strict";
+class BlueCurrentGoLiveCommandEngine{
+  constructor({eventBus,appState}={}){this.eventBus=eventBus;this.appState=appState;}
+  token(){return localStorage.getItem("blueCurrentV3230Token")||"";}
