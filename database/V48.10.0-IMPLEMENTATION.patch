+function render(s){$("pppDecision").textContent=s.recommendation?.decision||"CONFIGURE";$("pppOverall").textContent=s.scorecard?.overall??"—";$("pppValue").textContent=money(s.valueLedger?.verifiedRealizedImpactDollars||0);$("pppExceptions").textContent=(s.exceptions||[]).length;$("pppHeadline").textContent=s.headline||"Pilot proof program loading…";$("pppProgram").textContent=s.program?`${s.program.name} · ${s.program.sponsor} · Day ${s.program.ageDays}/${s.program.pilotDays}`:"Pilot baseline required.";
