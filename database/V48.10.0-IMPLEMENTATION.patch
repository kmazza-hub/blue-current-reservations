+$("pppLocations").innerHTML=(s.locationObjectives||[]).map(x=>`<article><strong>${esc(x.locationName)} · ${esc(x.owner||"Unassigned")}</strong><p>${esc(x.objective)}</p><div class="hpc-meta"><span>Readiness ${x.readiness.current}${x.readiness.target!=null?` / ${x.readiness.target}`:""}</span><span>Rhythm ${x.rhythm.current}%${x.rhythm.target!=null?` / ${x.rhythm.target}%`:""}</span><span>Leakage ${money(x.leakage.current)}</span><span>Reduction ${x.leakage.reductionPercent}%</span><span>Targets ${x.targetsMet}/${x.targetsMeasured}</span></div></article>`).join("")||"<article><span>No location objectives available.</span></article>";
+$("pppTrend").innerHTML=(s.trend||[]).map(x=>`<article><strong>${esc(x.label)}</strong><span>Readiness ${x.readiness} · Rhythm ${x.rhythm}% · Leakage ${money(x.leakage)} · Verified ${money(x.verifiedValue)}${x.overall==null?"":` · Score ${x.overall}`}</span></article>`).join("");
