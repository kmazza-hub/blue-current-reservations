/* V100.2.31 — Arrival Mark Arrived Fit
   Aim small, miss small: the reservation arrival action must be fully visible and obvious. */

/* In Arrivals, "Expected" and "Mark arrived" were competing for the same action column.
   The action already communicates the state, so remove the redundant Expected pill whenever
   the reservation is still waiting to check in. */
#host-stand #arrivalQueue .queue-item.arrival .arrival-chip.pending {
  display:none !important;
}

/* Three jobs only: time, guest context, action. */
#host-stand #arrivalQueue .queue-item.arrival {
  width:100% !important;
  max-width:100% !important;
  min-width:0 !important;
  box-sizing:border-box !important;
  display:grid !important;
  grid-template-columns:54px minmax(0,1fr) 108px !important;
  gap:8px !important;
  align-items:center !important;
  padding:11px 9px !important;
  overflow:hidden !important;
}

#host-stand #arrivalQueue .queue-item.arrival > div {
  min-width:0 !important;
  max-width:100% !important;
}

/* The check-in action owns the third column and never wraps or clips. */
#host-stand #arrivalQueue .bc-mark-arrived-v100-2-17,
#host-stand #arrivalQueue .bc-arrival-action-v100-2-13 {
  grid-column:3 !important;
  grid-row:1 !important;
  justify-self:stretch !important;
  align-self:center !important;
  width:108px !important;
  min-width:108px !important;
  max-width:108px !important;
  min-height:46px !important;
  margin:0 !important;
  padding:0 8px !important;
  box-sizing:border-box !important;
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  border:2px solid #31c6e4 !important;
  border-radius:12px !important;
  background:#087d99 !important;
  color:#ffffff !important;
  -webkit-text-fill-color:#ffffff !important;
  opacity:1 !important;
  font-size:.82rem !important;
  line-height:1 !important;
  font-weight:950 !important;
  text-align:center !important;
  white-space:nowrap !important;
  overflow:visible !important;
}

/* Give the queue scrollbar its own breathing room instead of stealing button width. */
#host-stand #arrivalQueue {
  box-sizing:border-box !important;
  padding-right:8px !important;
}

/* Full Reservations workspace: if the generic Mark arrived action is injected into a
   reservation row, keep it readable rather than allowing inherited compact button geometry. */
#host-stand #bcReservationList article .bc-mark-arrived-v100-2-17 {
  width:auto !important;
  min-width:112px !important;
  max-width:none !important;
  min-height:46px !important;
  padding:0 14px !important;
  white-space:nowrap !important;
  overflow:visible !important;
  color:#ffffff !important;
  -webkit-text-fill-color:#ffffff !important;
}

@media (max-width:1100px) {
  #host-stand #arrivalQueue .queue-item.arrival {
    grid-template-columns:50px minmax(0,1fr) 104px !important;
    gap:7px !important;
    padding:10px 8px !important;
  }
  #host-stand #arrivalQueue .bc-mark-arrived-v100-2-17,
  #host-stand #arrivalQueue .bc-arrival-action-v100-2-13 {
    width:104px !important;
    min-width:104px !important;
    max-width:104px !important;
    padding-inline:6px !important;
    font-size:.79rem !important;
  }
}
