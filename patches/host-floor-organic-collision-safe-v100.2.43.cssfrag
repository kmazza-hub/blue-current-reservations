/* V100.2.43 — Organic Collision-Safe Restaurant Floor */
/* Restores the more natural, room-like composition while keeping guaranteed breathing room. */
#hostFloorMap[data-bc-world-class-v100237="true"] .host-table { transform:translate(-50%,-50%) !important; }

